{
  "name": "zorotreeking",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Personal site: AI learning · Investment · Photography · Hiking",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/build-photo-manifests.ts && astro dev",
    "start": "tsx scripts/build-photo-manifests.ts && astro dev",
    "prebuild": "bash scripts/setup-fonts.sh && node scripts/cover-variants.mjs",
    "build": "tsx scripts/build-photo-manifests.ts && tsx scripts/check-content-lang.ts && astro build && pagefind --site dist",
    "photo:manifests": "tsx scripts/build-photo-manifests.ts",
    "preview": "astro preview",
    "pretest": "node scripts/sync-known-debt.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "sync:debt": "node scripts/sync-known-debt.mjs",
    "check:debt": "node scripts/sync-known-debt.mjs --check",
    "fix:recap-names": "python3 scripts/wind/backfill_en_names.py --headlines",
    "check:content-quality": "node scripts/check-content-quality.mjs",
    "check": "astro check",
    "validate:etf": "tsx scripts/validate-etf-snapshot.ts",
    "verify": "npm run validate:etf && npm run check && npm test && npm run build",
    "astro": "astro",
    "check:admin": "node scripts/check-admin-config.mjs",
    "check:hydration": "node scripts/check-hydration.mjs --cross-time",
    "check:hydration-drift": "node scripts/check-hydration-drift.mjs",
    "check:images": "node scripts/check-image-budget.mjs",
    "check:sectors": "node scripts/check-sector-names.mjs",
    "clean:derived": "node scripts/clean-derived-images.mjs",
    "perf:inp": "node scripts/inp-probe.mjs",
    "check:og": "node scripts/check-og.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "gate": "npm run check:workflows && npm run validate:etf && npm run check:dates && npm run check:digest-quality && npm run check:content-quality && npm run check && npm test && npm run build && npm run check:weight && npm run check:home-featured && npm run check:auto-disclosure && npm run check:translation-notice && npm run check:images && npm run check:links && npm run check:orphans && npm run check:script-index && npm run check:sectors && npm run check:og && npm run check:ssr-clock && npm run check:hydration && npm run check:hydration-drift && npm run check:degraded && npm run check:search:dist && npm run check:a11y:fast && npm run check:interactions && npm run check:focus && npm run check:text-zoom && npm run check:legible && npm run check:runtime -- --vitals --cls=0.12 --lcp=8000 && npm run check:font-fallback && npm run check:feeds && npm run check:i18n-leaks && npm run check:lang-switch && npm run check:seo && npm run check:admin",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-push && echo '已启用 .githooks（pre-push 门禁）'",
    "perf:history": "node scripts/lighthouse-history.mjs",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "perf:local": "node scripts/perf-local.mjs",
    "tbt:probe": "node scripts/tbt-probe.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "check:home-featured": "node scripts/check-home-featured.mjs",
    "check:auto-disclosure": "node scripts/check-auto-disclosure.mjs",
    "check:translation-notice": "node scripts/check-translation-notice.mjs",
    "check:script-index": "node scripts/check-script-index.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:feeds": "node scripts/check-feeds.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:focus": "node scripts/check-focus.mjs",
    "check:text-zoom": "node scripts/check-text-zoom.mjs",
    "check:legible": "node scripts/check-legible-text.mjs",
    "check:interactions": "node scripts/check-interactions.mjs",
    "check:dates": "node scripts/check-content-dates.mjs",
    "check:digest-quality": "node scripts/check-digest-placeholders.mjs --days=7",
    "check:ssr-clock": "node scripts/check-ssr-clock.mjs",
    "check:font-fallback": "node scripts/check-font-fallback.mjs",
    "check:perf": "node scripts/check-runtime.mjs --vitals --mobile --throttle",
    "audit:site": "node scripts/audit-site.mjs --vitals",
    "check:server": "node scripts/check-server.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:freshness": "node scripts/check-freshness.mjs",
    "check:deploy-freshness": "node scripts/check-deploy-freshness.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:search:dist": "node scripts/check-search.mjs --dist",
    "check:a11y:fast": "node scripts/check-a11y.mjs --dist --paths=/,/invest/,/invest/us-market/,/ai/digest-2026-06-05/,/en/ai/digest-2026-11-25/,/photo/baokemeng/,/guestbook/,/search/,/en/search/",
    "check:market-age": "node scripts/check-market-data-age.mjs",
    "check:lang-switch": "node scripts/check-lang-switch.mjs",
    "check:i18n-leaks": "node scripts/check-i18n-leaks.mjs",
    "check:a11y:sample": "node scripts/check-a11y.mjs --dist --sitemap=dist/sitemap.xml --sample=12 --seed=$(date -u +%G-W%V)",
    "report:weight": "node scripts/report-page-weight.mjs",
    "check:weight": "node scripts/check-page-weight.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:api-freshness": "node scripts/check-api-freshness.mjs",
    "check:degraded": "node scripts/check-degraded.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/rss": "^4.0.19",
    "astro": "~7.4.1",
    "autoprefixer": "^10.5.4",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "^5.10.1",
    "leaflet": "^1.9.4",
    "marked": "^18.2.0",
    "photoswipe": "^5.4.4",
    "postcss": "^8.5.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^3.4.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "exifr": "^7.1.3",
    "pagefind": "^1.5.2",
    "playwright": "^1.65.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "fflate": "^0.8.3",
    "postcss-selector-parser": "^6.1.6"
  }
}
