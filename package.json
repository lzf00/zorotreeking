{
  "name": "zorotreeking",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Personal site: AI learning · Investment · Photography · Hiking",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/build-photo-manifests.ts && astro dev",
    "start": "tsx scripts/build-photo-manifests.ts && astro dev",
    "prebuild": "bash scripts/setup-fonts.sh && node scripts/cover-variants.mjs",
    "build": "tsx scripts/build-photo-manifests.ts && tsx scripts/check-content-lang.ts && astro build && pagefind --site dist",
    "photo:manifests": "tsx scripts/build-photo-manifests.ts",
    "preview": "astro preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "astro check",
    "validate:etf": "tsx scripts/validate-etf-snapshot.ts",
    "verify": "npm run validate:etf && npm run check && npm test && npm run build",
    "astro": "astro",
    "check:admin": "node scripts/check-admin-config.mjs",
    "check:hydration": "node scripts/check-hydration.mjs --cross-time",
    "check:images": "node scripts/check-image-budget.mjs",
    "check:sectors": "node scripts/check-sector-names.mjs",
    "clean:derived": "node scripts/clean-derived-images.mjs",
    "perf:inp": "node scripts/inp-probe.mjs",
    "check:og": "node scripts/check-og.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "gate": "npm run validate:etf && npm run check:dates && npm run check && npm test && npm run build && npm run check:images && npm run check:links && npm run check:sectors && npm run check:og && npm run check:ssr-clock && npm run check:hydration && npm run check:font-fallback && npm run check:feeds && npm run check:seo && npm run check:admin",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-push && echo '已启用 .githooks（pre-push 门禁）'",
    "perf:history": "node scripts/lighthouse-history.mjs",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "perf:local": "node scripts/perf-local.mjs",
    "tbt:probe": "node scripts/tbt-probe.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:feeds": "node scripts/check-feeds.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:interactions": "node scripts/check-interactions.mjs",
    "check:dates": "node scripts/check-content-dates.mjs",
    "check:ssr-clock": "node scripts/check-ssr-clock.mjs",
    "check:font-fallback": "node scripts/check-font-fallback.mjs",
    "check:perf": "node scripts/check-runtime.mjs --vitals --mobile --throttle",
    "audit:site": "node scripts/audit-site.mjs --vitals",
    "check:server": "node scripts/check-server.mjs",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/rss": "^4.0.19",
    "astro": "~7.4.1",
    "autoprefixer": "^10.5.4",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "^5.10.1",
    "leaflet": "^1.9.4",
    "marked": "^18.2.0",
    "photoswipe": "^5.4.4",
    "postcss": "^8.5.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^3.4.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "exifr": "^7.1.3",
    "pagefind": "^1.5.2",
    "playwright": "^1.65.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "fflate": "^0.8.3",
    "postcss-selector-parser": "^6.1.6"
  }
}
