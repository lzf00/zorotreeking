{
  "name": "zorotreeking",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Personal site: AI learning · Investment · Photography · Hiking",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "bash scripts/setup-fonts.sh",
    "build": "tsx scripts/build-photo-manifests.ts && astro build && pagefind --site dist",
    "photo:manifests": "tsx scripts/build-photo-manifests.ts",
    "preview": "astro preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "astro check",
    "validate:etf": "tsx scripts/validate-etf-snapshot.ts",
    "verify": "npm run validate:etf && npm run check && npm test && npm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.1.5",
    "autoprefixer": "^10.5.4",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "^5.10.1",
    "leaflet": "^1.9.4",
    "marked": "^14.1.4",
    "photoswipe": "^5.4.4",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^3.4.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "exifr": "^7.1.3",
    "pagefind": "^1.5.2",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
