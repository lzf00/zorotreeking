{
  "name": "zorotreeking",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Personal site: AI learning · Investment · Photography · Hiking",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/build-photo-manifests.ts && astro dev",
    "start": "tsx scripts/build-photo-manifests.ts && astro dev",
    "prebuild": "bash scripts/setup-fonts.sh",
    "build": "tsx scripts/build-photo-manifests.ts && tsx scripts/check-content-lang.ts && astro build && pagefind --site dist",
    "photo:manifests": "tsx scripts/build-photo-manifests.ts",
    "preview": "astro preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "astro check",
    "validate:etf": "tsx scripts/validate-etf-snapshot.ts",
    "verify": "npm run validate:etf && npm run check && npm test && npm run build",
    "astro": "astro",
    "check:admin": "node scripts/check-admin-config.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/rss": "^4.0.19",
    "astro": "~7.4.1",
    "autoprefixer": "^10.5.4",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "^5.10.1",
    "leaflet": "^1.9.4",
    "marked": "^18.2.0",
    "photoswipe": "^5.4.4",
    "postcss": "^8.5.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^3.4.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "exifr": "^7.1.3",
    "pagefind": "^1.5.2",
    "playwright": "^1.65.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "fflate": "^0.8.3",
    "postcss-selector-parser": "^6.1.6"
  }
}
