{
  "ci": {
    "collect": {
      "url": [
        "https://www.zorotreeking.online/",
        "https://www.zorotreeking.online/ai/",
        "https://www.zorotreeking.online/ai/digest-2026-06-05/",
        "https://www.zorotreeking.online/about/",
        "https://www.zorotreeking.online/explore/",
        "https://www.zorotreeking.online/photo/baokemeng/",
        "https://www.zorotreeking.online/invest/",
        "https://www.zorotreeking.online/en/"
      ],
      "numberOfRuns": 5,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "devtools",
        "chromeFlags": "--headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2000,
            "aggregationMethod": "median"
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 3000,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median"
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 300,
            "aggregationMethod": "median"
          }
        ],
        "color-contrast": [
          "error",
          {
            "minScore": 1
          }
        ],
        "is-on-https": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
