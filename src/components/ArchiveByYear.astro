---
/**
 * 全站归档：按年份倒序列出某语言下的内容（四个板块混排）。
 *
 * 之前中文站只有 /explore（按 embedding 投影的二维地图）和 /topics（主题聚合），
 * 英文站根本没有任何「从头翻一遍」的入口——订阅页只能把人送回首页。归档页补这个缺口：
 * 一行一篇，日期 + 板块 + 标题，年份分节，最上面给出总数与跨度。
 *
 * 第 190 轮改成**分页渲染**：这一页曾经一次吐出 1100 多行（368 KB，全站最重）。
 * 现在由页面负责切页并把当页的 `posts` 传进来 —— 组件自己不再取数，
 * 否则页面和组件各查一遍 collection，还容易在"这一页到底有几条"上对不上。
 */
import { siteDateString } from "@/lib/site-date";
import { pathWithLang, useTranslations, type Lang } from "@/i18n/ui";

export interface ArchivePost {
  section: "ai" | "invest" | "photo" | "hike";
  slug: string;
  title: string;
  date: Date;
}

interface Props {
  lang: Lang;
  /** 当前页的条目（由页面的 getStaticPaths/paginate 切好）。 */
  posts: ArchivePost[];
  /** 全部条目数（跨页显示"共 N 篇"）。 */
  total: number;
  /** 全站最新/最早一篇的日期：页头那行"共 N 篇 · 起止"讲的是整站，不是当页。 */
  newest?: Date;
  oldest?: Date;
}

const { lang, posts, total, newest, oldest } = Astro.props;
const t = useTranslations(lang);
const sections = ["ai", "invest", "photo", "hike"] as const;
const all = posts;

const byYear = new Map<number, ArchivePost[]>();
for (const post of all.sort((a, b) => b.date.getTime() - a.date.getTime())) {
  const year = post.date.getUTCFullYear();
  const bucket = byYear.get(year) ?? [];
  bucket.push(post);
  byYear.set(year, bucket);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const month = (d?: Date) => (d ? `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}` : "");
const span = newest && oldest ? (month(newest) === month(oldest) ? month(newest) : `${month(oldest)} → ${month(newest)}`) : "";
const sectionColor: Record<(typeof sections)[number], string> = {
  ai: "text-section-ai",
  invest: "text-section-invest",
  photo: "text-section-photo",
  hike: "text-section-hike",
};
---

<div class="mt-6 text-sm text-[var(--text-tertiary)]">
  {total} {lang === "zh" ? "篇" : total === 1 ? "post" : "posts"}
  {span && <span> · {span}</span>}
</div>

{/* 第 198 轮：这里是全站标题的汇总回声，不参与站内检索（每篇内容都有自己的页面）。
    归档页仍会被「归档 / 全部文章」这类查询命中，靠的是标题与上方那句计数说明。 */}
<div data-pagefind-ignore class="mt-8 space-y-10">
  {years.map((year) => (
    // 一页 500+ 行时，屏幕外的年份没必要参与布局与绘制
    <section style="content-visibility:auto;contain-intrinsic-size:auto 1200px">
      <h2 class="flex items-baseline gap-3 text-xs uppercase tracking-[0.18em] text-[var(--text-tertiary)]">
        <span>{year}</span>{" "}
        <span class="tabular-nums normal-case tracking-normal">
          {byYear.get(year)!.length} {lang === "zh" ? "篇" : byYear.get(year)!.length === 1 ? "post" : "posts"}
        </span>
      </h2>
      <ul class="mt-3 divide-y divide-[var(--border)] border-t border-[var(--border)]">
        {byYear.get(year)!.map((post) => (
          <li>
            <a
              href={pathWithLang(`/${post.section}/${post.slug}`, lang)}
              class="group flex items-baseline gap-3 py-2.5 hover:text-[var(--text)] transition-colors"
            >
              <time class="shrink-0 font-mono text-xs text-[var(--text-tertiary)]" datetime={siteDateString(post.date)}>
                {siteDateString(post.date)}
              </time>
              <span class={`shrink-0 text-xs ${sectionColor[post.section]}`}>{t(`section.${post.section}.title`)}</span>
              <span class="min-w-0 flex-1 text-[var(--text-secondary)] group-hover:text-[var(--text)]">{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<p class="mt-10 text-sm text-[var(--text-tertiary)]">
  {lang === "zh" ? (
    <>
      想按主题找？看 <a href={pathWithLang("/tag", lang)} class="underline decoration-1 underline-offset-2 hover:text-[var(--text)]">标签索引</a>
      ，或者 <a href={pathWithLang("/explore", lang)} class="underline decoration-1 underline-offset-2 hover:text-[var(--text)]">文章地图</a>。
    </>
  ) : (
    <>
      Looking for a topic instead? Try the <a href={pathWithLang("/tag", lang)} class="underline decoration-1 underline-offset-2 hover:text-[var(--text)]">tag index</a>.
    </>
  )}
</p>
