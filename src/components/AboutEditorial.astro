---
import ContentPulse from "@/components/ContentPulse.astro";
import { aboutData, type AboutLang } from "@/data/about";

interface Props {
  lang: AboutLang;
}

const { lang } = Astro.props;
const copy = aboutData[lang];
---

<article class="about-editorial overflow-hidden">
  <header class="relative max-w-6xl mx-auto px-5 pt-16 sm:pt-24 pb-20 sm:pb-28">
    <div
      class="pointer-events-none absolute -right-24 top-6 h-72 w-72 rounded-full opacity-50 blur-3xl"
      style="background: radial-gradient(circle, rgba(29,78,216,.14), rgba(107,33,168,.07) 48%, transparent 72%);"
      aria-hidden="true"
    ></div>

    <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8">
      <div class="lg:col-span-3">
        <p class="font-mono text-[11px] tracking-[0.22em] text-[var(--text-tertiary)]">
          {copy.eyebrow}
        </p>
        <div class="mt-5 hidden lg:block h-28 w-px bg-[var(--border)]"></div>
      </div>

      <div class="lg:col-span-9">
        <h1 class="font-serif-display text-[clamp(2.55rem,8vw,7.25rem)] leading-[0.9] tracking-[-0.045em] text-balance">
          {copy.title.split("\n").map((line, index) => (
            <>
              {index > 0 && <br />}
              <span class={`sm:whitespace-nowrap ${index === 1 ? "text-[var(--text-secondary)]" : ""}`}>{line}</span>
            </>
          ))}
        </h1>
        <p class="mt-8 sm:mt-10 max-w-2xl text-lg sm:text-2xl leading-relaxed text-[var(--text-secondary)]">
          {copy.tagline}
        </p>
      </div>
    </div>
  </header>

  <section class="border-y border-[var(--border)] bg-[var(--bg-soft)]/55">
    <div class="max-w-6xl mx-auto px-5 py-14 sm:py-20 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <div class="lg:col-span-3">
        <span class="ornament-letter text-7xl sm:text-8xl text-[var(--border)]" aria-hidden="true">Z</span>
      </div>
      <div class="lg:col-span-9 max-w-3xl space-y-6">
        {copy.intro.map((paragraph) => (
          <p class="text-lg sm:text-[1.35rem] leading-[1.75] text-[var(--text-secondary)]">
            {paragraph}
          </p>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 py-20 sm:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8">
      <div class="lg:col-span-3">
        <p class="font-mono text-[11px] tracking-[0.2em] text-[var(--text-tertiary)]">
          {copy.craftLabel}
        </p>
      </div>
      <ol class="lg:col-span-9 grid grid-cols-1 md:grid-cols-3 border-t border-l border-[var(--border)]">
        {copy.craft.map((item) => (
          <li class="min-h-64 border-r border-b border-[var(--border)] p-6 sm:p-8 flex flex-col">
            <span class="font-mono text-xs tracking-[0.18em] text-[var(--text-tertiary)]">{item.index}</span>
            <h2 class="mt-auto pt-12 font-serif-display text-3xl sm:text-4xl">{item.title}</h2>
            <p class="mt-4 text-sm sm:text-[15px] leading-relaxed text-[var(--text-secondary)]">
              {item.text}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-20 sm:pb-28">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 border-b border-[var(--border)] pb-5">
      <p class="font-mono text-[11px] tracking-[0.2em] text-[var(--text-tertiary)]">
        {copy.pathsLabel}
      </p>
      <p class="max-w-xl text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
        {copy.pathsIntro}
      </p>
    </div>

    <div class="divide-y divide-[var(--border)]">
      {copy.paths.map((path) => (
        <a
          href={path.href}
          class="about-path group grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-6 py-7 sm:py-9"
          style={`--path-color: ${path.color}`}
        >
          <span class="sm:col-span-3 font-mono text-[10px] tracking-[0.18em] text-[var(--text-tertiary)]">
            {path.label}
          </span>
          <span class="sm:col-span-4 font-serif-display text-3xl sm:text-4xl transition-colors group-hover:text-[var(--path-color)]">
            {path.title}
          </span>
          <span class="sm:col-span-4 text-sm sm:text-[15px] leading-relaxed text-[var(--text-secondary)]">
            {path.description}
          </span>
          <span class="sm:col-span-1 sm:text-right text-2xl transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-[var(--border)]">
    <div class="max-w-6xl mx-auto px-5 py-16 sm:py-20">
      <p class="font-mono text-[11px] tracking-[0.2em] text-[var(--text-tertiary)]">
        {copy.principlesLabel}
      </p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-px bg-[var(--border)] border border-[var(--border)]">
        {copy.principles.map((principle) => (
          <div class="bg-[var(--bg)] p-6 sm:p-8">
            <h2 class="text-base font-semibold">{principle.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">{principle.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 py-20 sm:py-28">
    <div class="relative overflow-hidden rounded-[2rem] bg-zinc-950 text-zinc-50 px-6 py-10 sm:p-12 lg:p-16">
      <div
        class="absolute -right-20 -top-24 h-80 w-80 rounded-full blur-3xl opacity-50"
        style="background: radial-gradient(circle, rgba(96,165,250,.55), rgba(168,85,247,.22) 52%, transparent 72%);"
        aria-hidden="true"
      ></div>
      <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8">
        <p class="lg:col-span-3 font-mono text-[10px] tracking-[0.22em] text-zinc-400">
          {copy.privacyLabel}
        </p>
        <div class="lg:col-span-8 lg:col-start-5">
          <h2 class="font-serif-display text-4xl sm:text-6xl leading-[0.98]">{copy.privacyTitle}</h2>
          <p class="mt-7 max-w-2xl text-sm sm:text-base leading-[1.8] text-zinc-300">
            {copy.privacyText}
          </p>
          <a
            href={copy.privacyLink}
            class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-white hover:text-blue-200 transition-colors"
          >
            {copy.privacyLinkLabel}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-20 sm:pb-28">
    <p class="font-mono text-[11px] tracking-[0.2em] text-[var(--text-tertiary)] mb-8">
      {copy.pulseLabel}
    </p>
    <div class="rounded-2xl border border-[var(--border)] px-5 sm:px-8 pt-7">
      <ContentPulse />
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-24">
    <div class="border-t border-[var(--border)] pt-12 sm:pt-16 flex flex-col lg:flex-row lg:items-end justify-between gap-8">
      <div class="max-w-2xl">
        <h2 class="font-serif-display text-4xl sm:text-6xl leading-tight">{copy.ctaTitle}</h2>
        <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">{copy.ctaText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={copy.paths[0].href}
          class="inline-flex items-center gap-2 rounded-full bg-black dark:bg-white text-white dark:text-black px-5 py-2.5 text-sm font-medium hover:opacity-80 transition-opacity"
        >
          {copy.ctaPrimary}
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/rss.xml"
          class="inline-flex items-center rounded-full border border-[var(--border)] px-5 py-2.5 text-sm font-medium hover:bg-[var(--bg-soft)] transition-colors"
        >
          {copy.ctaSecondary}
        </a>
      </div>
    </div>
  </section>
</article>

<style>
  .about-path {
    text-decoration: none;
  }

  .about-path:focus-visible {
    outline: 2px solid var(--path-color);
    outline-offset: 6px;
    border-radius: 0.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-path {
      transition: padding 180ms ease;
    }

    .about-path:hover {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }
</style>
