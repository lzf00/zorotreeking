---
import RouteGuideShell from "./RouteGuideShell.astro";
import AliLhasaReturnSheet from "./AliLhasaReturnSheet.astro";
import AliLhasaReturnRouteOverview from "./AliLhasaReturnRouteOverview.astro";

const route = ["拉萨", "日喀则", "定日", "珠峰景区", "萨嘎", "塔钦", "札达", "狮泉河", "改则", "色林措", "班戈", "纳木措", "拉萨", "上海"];
---

<RouteGuideShell
  variant="lhasa-loop"
  kicker="Ali grand loop · Lhasa pickup and return"
  title="从拉萨出发"
  accentTitle="再回到拉萨"
  lead="9 月 26 日拉萨取车，27 日开始阿里南北大环线；9 月 29 日上午进珠峰景区，当晚住巴松顺康富氧看日落和星空，30 日早上离开。全员 10 月 2 日到狮泉河补给，G317 经改则、色林措、班戈、纳木措回拉萨，10 月 4 日住纳木错富氧酒店（班戈店），10 月 5 日晚回拉萨住宿，10 月 6 日还车缓冲，10 月 7 日飞回上海。"
  facts={[["09.29", "巴松顺康"], ["G317", "改则过夜"], ["10.05", "拉萨住宿"]]}
  route={route}
  nav={[
    { href: "#loop-orders", label: "出发前订单" },
    { href: "#loop-verdict", label: "规划结论" },
    { href: "#loop-sheet", label: "总路书" },
    { href: "#route-atlas", label: "交互地图" },
    { href: "#loop-pacing", label: "日程取舍" },
    { href: "#loop-return", label: "回拉萨" },
    { href: "#loop-pack", label: "打包清单" },
    { href: "#loop-gates", label: "执行门槛" },
  ]}
  footerTitle="闭环的意义，是把时间花在该停的地方。"
  footerText="本页是 2026 国庆行前决策工具。地图、航班和车时均需在出发前按最新交警、景区、航空公司、租车合同和身体状态重新确认。"
>
  <section id="loop-verdict" class="rd-section">
    <aside id="loop-orders" class="rd-alert"><div class="rd-wrap"><b>出发前订单</b><p>三件事还没闭环：取消智行 09.28 萨嘎强吉福；取消去哪儿塔尔庆 09.29–10.01（10.01 已改住塔钦云端盛景）；续订 10.05–06 拉萨柏丽艾尚。10.04 纳木错富氧保持不变。酒店日期没对上之前，不要再加班公湖或札达过夜。</p></div></aside>
    <aside class="rd-alert"><div class="rd-wrap"><b>证件窗口</b><p>本行程按可办日喀则电子边境通行证、可进入定日和珠峰执行。电子证前往地需含日喀则市定日县，并继续持有阿里证。出发前再核 12367 与检查站口径；定日不放行再改走 <a href="/hike/travel/ali-grand-loop-ali-permit-2026/">绕证方案</a>，不去珠峰。</p></div></aside>
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">01 / Route verdict</p><div class="rd-rule"></div></div>
      <div><h2>这是珠峰过夜优先，<br />北线按两湖收口的闭环。</h2><p class="rd-copy">路线不再把珠峰做成当天折返赶萨嘎，也不再为提前返沪去狮泉河分流。9 月 29 日上午进入珠峰景区，傍晚回到巴松顺康富氧看日落和星空；狮泉河以后全员走 G317，10 月 3 日住改则，10 月 4 日经色林措住班戈，10 月 5 日上午看纳木措后回拉萨。</p></div>
    </div>
    <div class="rd-wrap rd-metrics">
      <div><strong>09.26</strong><span>贡嘎落地取车</span></div>
      <div><strong>09.27</strong><span>正式开始自驾</span></div>
      <div><strong>09.29</strong><span>巴松顺康富氧</span></div>
      <div><strong>10.05</strong><span>班戈经纳木措回拉萨</span></div>
    </div>
    <aside class="rd-alert"><div class="rd-wrap"><b>仍要接受的取舍</b><p>珠峰过夜占掉一天，10 月 5 日又必须住进拉萨，所以札达仍排不进单独住宿。北线已锁改则康盛，10 月 4 日住班戈、把纳木措放到次日上午，不再住洞措，也不再把改则到纳木措叠成一天。</p></div></aside>
  </section>

  <AliLhasaReturnSheet />

  <AliLhasaReturnRouteOverview />

  <section id="loop-pacing" class="rd-section rd-section--deep">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">02 / Why this pacing</p><div class="rd-rule"></div></div>
      <div><h2>去掉分流之后，<br />日程仍由珠峰过夜和 10 月 5 日回拉萨决定。</h2><p class="rd-copy">狮泉河 10 月 2 日过夜不再是为了赶昆莎机场。它只是巴松顺康过夜之后，还能给札达留出短参观、并让 G317 在 10 月 5 日前走完的落点。13 天原速的札达过夜、狮泉河连住和班公湖，这版排不进去。住宿锁定后，白天只加得动 09.27 白居寺和 10.01 拉昂措；不准时就取消，不改过夜点。</p></div>
    </div>
    <div class="rd-wrap rd-exit-grid">
      <article class="rd-exit"><span class="rd-status">保留</span><h3>09.29<br />珠峰过夜 · 顺康富氧</h3><p>上午进景区，日落前回到巴松顺康富氧看日落和星空，第二天早上再走。这是本版明确加回来的一天，后面所有压缩都从这里开始。</p><ul><li>09月29日：巴松顺康</li><li>09月30日：早上离开去萨嘎强吉福</li><li>门票、观光车、顺康保留房都要先确认</li></ul></article>
      <article class="rd-exit"><span class="rd-status">压缩但不空过</span><h3>10.02<br />札达短停后到狮泉河</h3><p>塔钦出发，土林穿行优先，古格或托林择一，日落前出盆地，当晚住狮泉河云朵酒店。狮泉河只做补给和车辆检查，次日早发改则，班公湖这版加不进去。</p><ul><li>不住札达，避免 10 月 5 日赶不上拉萨</li><li>土林优先，参观超时取消古格/托林</li><li>不去班公湖，把时间留给改则过夜</li></ul></article>
      <article class="rd-exit"><span class="rd-status">可执行拆法</span><h3>10.03–10.05<br />G317 改则 + 班戈</h3><p>改则康盛和纳木错富氧酒店（班戈店）已锁：4 日经色林措赶到班戈，5 日上午看纳木措后再回拉萨。</p><ul><li>10月3日：狮泉河 → 改则</li><li>10月4日：色林措 → 班戈</li><li>10月5日：班戈 → 纳木措 → 拉萨</li></ul></article>
    </div>
  </section>

  <section id="loop-return" class="rd-section">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">03 / Lhasa return</p><div class="rd-rule"></div></div>
      <div><h2>10月5日住进拉萨，<br />把10月6日留给恢复和还车。</h2><p class="rd-copy">狮泉河到拉萨的 G317 段按已锁酒店走：10 月 3 日住改则，10 月 4 日经色林措住纳木错富氧酒店（班戈店），10 月 5 日从班戈出发看纳木措后回拉萨。</p></div>
    </div>
    <div class="rd-wrap rd-card-grid">
      <article class="rd-card"><span>珠峰改法</span><h3>定日 → 巴松顺康</h3><p>9月29日上午进景区，日落前回到巴松顺康富氧，在酒店看日落和星空，第二天早上再走。</p></article>
      <article class="rd-card rd-card--accent"><span>前段保留</span><h3>萨嘎 → 塔钦 → 狮泉河</h3><p>10月1日保留玛旁雍措和冈仁波齐远观，准时再停拉昂措；10月2日札达土林穿行，古格/托林择一后到狮泉河云朵酒店过夜补给。</p></article>
      <article class="rd-card rd-card--night"><span>G317回程</span><h3>改则 → 色林措 → 班戈 → 纳木措 → 拉萨</h3><p>全员走完北线，只保留色林措和纳木措两个核心大景，10月4日住班戈，10月5日晚住拉萨。</p></article>
    </div>
  </section>

  <section id="loop-pack" class="rd-section">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">04 / Packing</p><div class="rd-rule"></div></div>
      <div><h2>装车时按表打勾，<br />不要靠一段说明记。</h2></div>
    </div>
    <div class="rd-wrap rd-metrics">
      <div><strong>上海</strong><span>衣服、护肤一次带齐</span></div>
      <div><strong>拉萨</strong><span>只补氧气、水、现金</span></div>
      <div><strong>5200</strong><span>巴松过夜按这层穿</span></div>
      <div><strong>勾选</strong><span>每人一套，装车打勾</span></div>
    </div>
    <div class="rd-wrap pack-sheet">
      <article>
        <header><b>01</b><h3>衣服鞋子</h3><small>分层穿 · 旧鞋</small></header>
        <ul>
          <li><i></i><strong>冲锋衣</strong><em>1 件</em><span>防风防水</span></li>
          <li><i></i><strong>羽绒 / 棉服</strong><em>1 件</em><span>巴松、班戈早上</span></li>
          <li><i></i><strong>抓绒 / 薄毛衣</strong><em>1 件</em><span>车里出汗后加</span></li>
          <li><i></i><strong>速干内衣</strong><em>3–4 套</em><span>排汗</span></li>
          <li><i></i><strong>保暖内衣</strong><em>1 套</em><span>巴松过夜</span></li>
          <li><i></i><strong>长裤</strong><em>2 条</em><span>不单带短裤</span></li>
          <li><i></i><strong>帽 / 脖套 / 手套</strong><em>各 1</em><span>山口挡风</span></li>
          <li><i></i><strong>墨镜</strong><em>1 副</em><span>必须</span></li>
          <li><i></i><strong>闭口鞋</strong><em>1 双</em><span>穿过的，不带新鞋</span></li>
          <li><i></i><strong>拖鞋 + 厚袜</strong><em>3–4 双袜</em><span>酒店用</span></li>
        </ul>
      </article>
      <article>
        <header><b>02</b><h3>护肤日用</h3><small>上海带够</small></header>
        <ul>
          <li><i></i><strong>防晒霜</strong><em>SPF50+</em><span>车里也补</span></li>
          <li><i></i><strong>润唇膏</strong><em>2 支</em><span>随身 + 车上</span></li>
          <li><i></i><strong>保湿面霜</strong><em>1 盒</em><span>偏油，不刷酸</span></li>
          <li><i></i><strong>护手霜</strong><em>1 支</em><span>风先伤手背</span></li>
          <li><i></i><strong>洁面 + 洗护</strong><em>小样</em><span>北线酒店不一定齐</span></li>
          <li><i></i><strong>牙刷牙膏</strong><em>各 1</em><span>湿巾、洗脸巾、棉签</span></li>
          <li><i></i><strong>喷鼻 + 眼药水</strong><em>各 1</em><span>干、风沙</span></li>
          <li><i></i><strong>卫生用品</strong><em>按人</em><span>风沙天改戴框架镜</span></li>
          <li><i></i><strong>剪刀 / 钳 / 创可贴</strong><em>各 1</em><span>小包</span></li>
          <li class="pack-no"><i></i><strong>不带</strong><em>—</em><span>刷酸、去角质、新美白精华</span></li>
        </ul>
      </article>
      <article>
        <header><b>03</b><h3>药 · 氧 · 证件</h3><small>车上常备</small></header>
        <ul>
          <li><i></i><strong>血氧仪</strong><em>1 台</em><span>全车共用</span></li>
          <li><i></i><strong>便携氧气</strong><em>每人若干</em><span>+ 车载氧气</span></li>
          <li><i></i><strong>止痛 / 感冒 / 肠胃</strong><em>各 1 盒</em><span>创可贴、碘伏</span></li>
          <li><i></i><strong>处方药</strong><em>按医嘱</em><span>不另加抗高反神药</span></li>
          <li><i></i><strong>保温壶 + 零食</strong><em>随车</em><span>电解质</span></li>
          <li><i></i><strong>头灯 / 充电宝</strong><em>各 1</em><span>车充、备用线</span></li>
          <li><i></i><strong>身份证 + 驾照</strong><em>原件</em><span>边防证打印纸</span></li>
          <li><i></i><strong>现金</strong><em>够北线</em><span>POS 不稳</span></li>
          <li><i></i><strong>卫星通信</strong><em>1 套</em><span>离线地图</span></li>
          <li><i></i><strong>垃圾袋</strong><em>若干</em><span>不扔湖区和草场</span></li>
        </ul>
      </article>
    </div>
  </section>

  <section id="loop-gates" class="rd-section rd-section--night">
    <div class="rd-wrap"><p class="rd-eyebrow">05 / Go or no-go</p><h2>四个决定，<br />守住闭环和返沪。</h2>
      <div class="rd-gates">
        <article><b>01</b><h3>订单日期先对齐</h3><p>先处理 09.28 萨嘎撞期、取消塔尔庆旧单和 10.05–06 拉萨续订。10.01 已锁塔钦云端盛景，10.04 纳木错富氧保持不变。巴松顺康已锁 09.29；门票和观光车仍要确认，到店异常才转吉山吉舍。</p></article>
        <article><b>02</b><h3>改则康盛是北线开关</h3><p>10月3日晚已锁改则康盛富氧，不再赌洞措乡镇住宿；次日只赶到班戈，不再叠成 600 公里长途日。</p></article>
        <article><b>03</b><h3>10月5日从班戈看纳木措</h3><p>从班戈出发后，上午在开放道路看湖，再回拉萨；仍不去圣象天门、扎西半岛深度游或湖边支线。</p></article>
        <article><b>04</b><h3>两名司机与卫星通信</h3><p>北线服务稀疏，单车至少两名熟练司机、全尺寸备胎、防滑链和卫星通信。</p></article>
      </div>
      <div class="rd-links"><b>原有路线全部保留</b><a href="/hike/travel/ali-grand-loop-ali-permit-2026/">检查站不放行时的绕证备用 ↗</a><a href="/hike/travel/ali-grand-loop-2026/">原13天拉萨闭环 ↗</a><a href="/hike/travel/ali-grand-loop-lhasa-lanzhou-2026/">兰州还车版 ↗</a><a href="/hike/travel/ali-central-loop-nagqu-g317-chengdu-2026/">G317成都版 ↗</a></div>
    </div>
  </section>
</RouteGuideShell>

<style>
  .pack-sheet {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 40px;
    border: 1px solid var(--rd-line);
    background: #f6f0e2;
  }
  .pack-sheet article {
    min-width: 0;
    border-right: 1px solid var(--rd-line);
  }
  .pack-sheet article:last-child { border-right: 0; }
  .pack-sheet header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: baseline;
    padding: 16px 16px 12px;
    border-bottom: 1px solid var(--rd-line);
    background: rgba(25, 32, 30, .04);
  }
  .pack-sheet header b {
    color: var(--rd-accent);
    font: 700 .68rem/1 var(--rd-mono);
    letter-spacing: .1em;
  }
  .pack-sheet header h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1;
  }
  .pack-sheet header small {
    color: var(--rd-muted);
    font: 700 .64rem/1 var(--rd-mono);
    letter-spacing: .06em;
  }
  .pack-sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pack-sheet li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1.1fr) auto minmax(0, .9fr);
    gap: 8px;
    align-items: center;
    padding: 9px 14px;
    border-bottom: 1px solid rgba(25, 32, 30, .08);
    font-size: .86rem;
    line-height: 1.3;
  }
  .pack-sheet li:last-child { border-bottom: 0; }
  .pack-sheet li i {
    width: 13px;
    height: 13px;
    border: 1px solid var(--rd-accent);
    background: #fff;
  }
  .pack-sheet li strong {
    font-weight: 600;
  }
  .pack-sheet li em {
    color: var(--rd-accent);
    font: 700 .68rem/1 var(--rd-mono);
    letter-spacing: .02em;
    font-style: normal;
    white-space: nowrap;
  }
  .pack-sheet li span {
    color: var(--rd-muted);
    font-size: .78rem;
  }
  .pack-sheet li.pack-no {
    background: rgba(173, 63, 45, .08);
  }
  .pack-sheet li.pack-no i { background: rgba(173, 63, 45, .15); }
  @media (max-width: 900px) {
    .pack-sheet { grid-template-columns: 1fr; }
    .pack-sheet article { border-right: 0; border-bottom: 1px solid var(--rd-line); }
    .pack-sheet article:last-child { border-bottom: 0; }
  }
  @media (max-width: 600px) {
    .pack-sheet li {
      grid-template-columns: 16px 1fr auto;
    }
    .pack-sheet li span {
      grid-column: 2 / -1;
      padding-left: 0;
    }
  }
</style>

