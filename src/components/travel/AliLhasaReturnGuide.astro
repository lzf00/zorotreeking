---
import RouteGuideShell from "./RouteGuideShell.astro";
import AliLhasaReturnSheet from "./AliLhasaReturnSheet.astro";
import AliLhasaReturnRouteOverview from "./AliLhasaReturnRouteOverview.astro";

const route = ["拉萨", "日喀则", "定日", "珠峰景区", "萨嘎", "塔钦", "札达", "狮泉河", "洞措", "色林措", "班戈", "纳木措", "拉萨", "上海"];
---

<RouteGuideShell
  variant="lhasa-loop"
  kicker="Ali grand loop · Lhasa pickup and return"
  title="从拉萨出发"
  accentTitle="再回到拉萨"
  lead="9 月 26 日拉萨取车，27 日开始阿里南北大环线；9 月 29 日上午进珠峰景区，当晚留在景区看日落和星空，30 日早上离开。全员 10 月 2 日到狮泉河补给，G317 只保留色林措和纳木措两个大景，按洞措、班戈、拉萨三段回程，10 月 5 日晚回拉萨住宿，10 月 6 日还车缓冲，10 月 7 日飞回上海。"
  facts={[["09.29", "珠峰景区住宿"], ["G317", "三段回程"], ["10.05", "拉萨住宿"]]}
  route={route}
  nav={[
    { href: "#loop-verdict", label: "规划结论" },
    { href: "#loop-sheet", label: "总路书" },
    { href: "#route-atlas", label: "交互地图" },
    { href: "#loop-pacing", label: "日程取舍" },
    { href: "#loop-return", label: "回拉萨" },
    { href: "#loop-gates", label: "执行门槛" },
  ]}
  footerTitle="闭环的意义，是把时间花在该停的地方。"
  footerText="本页是 2026 国庆行前决策工具。地图、航班和车时均需在出发前按最新交警、景区、航空公司、租车合同和身体状态重新确认。"
>
  <section id="loop-verdict" class="rd-section">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">01 / Route verdict</p><div class="rd-rule"></div></div>
      <div><h2>这是珠峰过夜优先，<br />北线按两湖收口的闭环。</h2><p class="rd-copy">路线不再把珠峰做成当天折返赶萨嘎，也不再为提前返沪去狮泉河分流。9 月 29 日上午进入珠峰景区，住在景区开放住宿点看日落和星空；狮泉河以后全员走 G317，只保留色林措和纳木措两个大景，用三天回到拉萨。</p></div>
    </div>
    <div class="rd-wrap rd-metrics">
      <div><strong>09.26</strong><span>贡嘎落地取车</span></div>
      <div><strong>09.27</strong><span>正式开始自驾</span></div>
      <div><strong>09.29</strong><span>珠峰景区住宿</span></div>
      <div><strong>10.05</strong><span>纳木措后回拉萨</span></div>
    </div>
    <aside class="rd-alert"><div class="rd-wrap"><b>仍要接受的取舍</b><p>珠峰过夜占掉一天，10 月 5 日又必须住进拉萨，所以札达仍排不进单独住宿，北线也做不到原 13 天那种改则、尼玛、班戈各住一晚。洞措只用来拆开狮泉河到班戈的长路，不是景点。</p></div></aside>
  </section>

  <AliLhasaReturnSheet />

  <AliLhasaReturnRouteOverview />

  <section id="loop-pacing" class="rd-section rd-section--deep">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">02 / Why this pacing</p><div class="rd-rule"></div></div>
      <div><h2>去掉分流之后，<br />日程仍由珠峰过夜和 10 月 5 日回拉萨决定。</h2><p class="rd-copy">狮泉河 10 月 2 日过夜不再是为了赶昆莎机场。它只是珠峰景区住宿之后，还能给札达留出短参观、并让 G317 在 10 月 5 日前走完的落点。13 天原速的札达过夜和北线四天拆法，这版排不进去。</p></div>
    </div>
    <div class="rd-wrap rd-exit-grid">
      <article class="rd-exit"><span class="rd-status">保留</span><h3>09.29<br />珠峰景区过夜</h3><p>上午进景区，当晚看日落和星空，第二天早上再走。这是本版明确加回来的一天，后面所有压缩都从这里开始。</p><ul><li>09月29日：景区住宿</li><li>09月30日：早上离开去萨嘎</li><li>门票、观光车、住宿都要先确认</li></ul></article>
      <article class="rd-exit"><span class="rd-status">压缩但不空过</span><h3>10.02<br />札达短停后到狮泉河</h3><p>塔钦出发，土林穿行，古格或托林择一，日落前出盆地，当晚住狮泉河。全员继续北返，狮泉河只做补给和车辆检查。</p><ul><li>不住札达，避免 10 月 5 日赶不上拉萨</li><li>不再为机场赶 16:00 出谷</li><li>参观超时就取消古格/托林</li></ul></article>
      <article class="rd-exit"><span class="rd-status">可执行拆法</span><h3>10.03–10.05<br />G317 三天两湖</h3><p>原 13 天北线是改则、尼玛、班戈、拉萨四晚。这版改成洞措、班戈、拉萨，把单日压在 400–580 公里，只留色林措和纳木措。</p><ul><li>10月3日：狮泉河 → 洞措</li><li>10月4日：色林措 → 班戈</li><li>10月5日：纳木措 → 拉萨</li></ul></article>
    </div>
  </section>

  <section id="loop-return" class="rd-section">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">03 / Lhasa return</p><div class="rd-rule"></div></div>
      <div><h2>10月5日住进拉萨，<br />把10月6日留给恢复和还车。</h2><p class="rd-copy">狮泉河到拉萨的 G317 段不再为洞措、尼玛这些中途节点停留太久，真正留下的是色林措和纳木措。10 月 3 日赶到洞措，10 月 4 日经色林措到班戈，10 月 5 日经纳木措和当雄回拉萨，班戈到拉萨按 400–450 公里、傍晚到晚间到店估。</p></div>
    </div>
    <div class="rd-wrap rd-card-grid">
      <article class="rd-card"><span>珠峰改法</span><h3>定日 → 珠峰景区</h3><p>9月29日上午进景区，当晚住景区开放住宿点，看日落和星空，第二天早上再走。</p></article>
      <article class="rd-card rd-card--accent"><span>前段保留</span><h3>萨嘎 → 塔钦 → 狮泉河</h3><p>10月1日保留玛旁雍措和冈仁波齐远观，10月2日札达土林穿行，古格/托林择一后到狮泉河过夜补给。</p></article>
      <article class="rd-card rd-card--night"><span>G317回程</span><h3>洞措 → 色林措 → 纳木措 → 拉萨</h3><p>全员走完北线，只保留色林措和纳木措两个核心大景，10月5日晚住拉萨。</p></article>
    </div>
  </section>

  <section id="loop-gates" class="rd-section rd-section--night">
    <div class="rd-wrap"><p class="rd-eyebrow">04 / Go or no-go</p><h2>四个决定，<br />守住闭环和返沪。</h2>
      <div class="rd-gates">
        <article><b>01</b><h3>珠峰住宿先确认</h3><p>门票、观光车和景区开放住宿点必须同时确认；订不到就不能按星空版执行。</p></article>
        <article><b>02</b><h3>洞措住宿是开关</h3><p>10月3日晚必须有洞措可住点；确认不了就改住改则，并接受10月4日更长赶路。</p></article>
        <article><b>03</b><h3>10月5日只短停纳木措</h3><p>纳木措保留为第二个大景，但不去圣象天门、扎西半岛深度游或湖边支线。</p></article>
        <article><b>04</b><h3>两名司机与卫星通信</h3><p>北线服务稀疏，单车至少两名熟练司机、全尺寸备胎、防滑链和卫星通信。</p></article>
      </div>
      <div class="rd-links"><b>原有路线全部保留</b><a href="/hike/travel/ali-grand-loop-2026/">原13天拉萨闭环 ↗</a><a href="/hike/travel/ali-grand-loop-lhasa-lanzhou-2026/">兰州还车版 ↗</a><a href="/hike/travel/ali-central-loop-nagqu-g317-chengdu-2026/">G317成都版 ↗</a></div>
    </div>
  </section>
</RouteGuideShell>
