---
import RouteGuideShell from "./RouteGuideShell.astro";
import AliLhasaReturnRouteOverview from "./AliLhasaReturnRouteOverview.astro";

const route = ["拉萨", "日喀则", "定日", "珠峰", "萨嘎", "塔钦", "札达", "狮泉河", "改则", "尼玛", "班戈", "纳木措", "拉萨", "上海"];
---

<RouteGuideShell
  variant="lhasa-loop"
  kicker="Ali grand loop · Lhasa pickup and return"
  title="从拉萨出发"
  accentTitle="再回到拉萨"
  lead="9 月 26 日拉萨取车，27 日开始阿里南北大环线；10 月 6 日下午或晚上回拉萨并完成还车，10 月 7 日飞回上海。朋友最晚 10 月 5 日抵达上海，仍在 10 月 2 日狮泉河分流，走阿里昆莎机场。"
  facts={[["≈ 4,000 KM", "拉萨取还完整闭环"], ["10.06", "下午或晚上回拉萨"], ["10.03—04", "朋友昆莎机场退出"]]}
  route={route}
  nav={[
    { href: "#loop-verdict", label: "规划结论" },
    { href: "#route-atlas", label: "交互地图" },
    { href: "#loop-exits", label: "提前返沪" },
    { href: "#loop-return", label: "回拉萨" },
    { href: "#loop-gates", label: "执行门槛" },
  ]}
  footerTitle="闭环的意义，是把退路也画进去。"
  footerText="本页是 2026 国庆行前决策工具。地图、航班和车时均需在出发前按最新交警、景区、航空公司、租车合同和身体状态重新确认。"
>
  <section id="loop-verdict" class="rd-section">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">01 / Route verdict</p><div class="rd-rule"></div></div>
      <div><h2>这是目前最完整，<br />也最容易还车的闭环。</h2><p class="rd-copy">路线不再向兰州或成都异地还车，而是沿阿里南线向西、北线向东，在班戈和纳木措收口回拉萨。10 月 6 日只把纳木措视为可取消项：越早回拉萨，10 月 7 日返沪越稳。</p></div>
    </div>
    <div class="rd-wrap rd-metrics">
      <div><strong>09.26</strong><span>贡嘎落地取车</span></div>
      <div><strong>09.27</strong><span>正式开始自驾</span></div>
      <div><strong>10.02</strong><span>狮泉河机场分流</span></div>
      <div><strong>10.06</strong><span>拉萨还车</span></div>
    </div>
    <aside class="rd-alert"><div class="rd-wrap"><b>10 月 6 日收口规则</b><p>班戈出发后，若 11:30 前不能确认纳木措开放、天气和剩余日照，直接经当雄返回拉萨。目标是 17:00—20:00 完成还车，不是为最后一个景点牺牲返沪缓冲。</p></div></aside>
  </section>

  <AliLhasaReturnRouteOverview />

  <section id="loop-exits" class="rd-section rd-section--deep">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">02 / Early exit</p><div class="rd-rule"></div></div>
      <div><h2>朋友最晚10月5日到上海，<br />狮泉河仍是最好的分流点。</h2><p class="rd-copy">团队 10 月 2 日抵达狮泉河后，朋友不再随主车进入改则和尼玛。可以 10 月 3 日离开以保留缓冲，也可以在狮泉河多住一晚、10 月 4 日经昆莎机场压线返程；不能等到 10 月 4 日进入尼玛后再决定。</p></div>
    </div>
    <div class="rd-wrap rd-exit-grid">
      <article class="rd-exit"><span class="rd-status">首选 · 有缓冲</span><h3>10.03<br />阿里昆莎机场</h3><p>当前2026夏秋航季拉萨—昆莎维持每日约3班，且已开通昆莎—成都直飞。优先购买3日离开、4日抵沪的联程，5日作为航变缓冲。</p><ul><li>10月2日晚：狮泉河分流住宿</li><li>10月3日：昆莎→拉萨或成都</li><li>10月4日：抵达上海</li><li>10月5日：航变缓冲</li></ul></article>
      <article class="rd-exit"><span class="rd-status">可行 · 压线</span><h3>10.04<br />昆莎机场离开</h3><p>朋友在狮泉河多住一晚，4日乘机去拉萨或成都，5日抵达上海。必须提前买好全部航段，并确认订单明确显示10月5日落地上海；该方案没有航变余量。</p><ul><li>10月3日：狮泉河休整</li><li>10月4日：昆莎→拉萨或成都</li><li>10月5日：最晚当日抵沪</li></ul></article>
      <article class="rd-exit"><span class="rd-status">更早备用</span><h3>10.01<br />阿里普兰机场</h3><p>团队9月30日晚住塔钦，朋友可在落实独立车辆后前往约93公里外的普兰机场。它会少参加札达、古格和狮泉河，只在昆莎无票时采用。</p></article>
    </div>
  </section>

  <section id="loop-return" class="rd-section">
    <div class="rd-wrap rd-split">
      <div><p class="rd-eyebrow">03 / Lhasa return</p><div class="rd-rule"></div></div>
      <div><h2>10月6日回到拉萨，<br />把10月7日只留给飞行。</h2><p class="rd-copy">班戈至拉萨有两档收口。常规版经过开放的纳木措观景区域；保守版取消纳木措，直接经当雄回拉萨。只要天气、车辆或人员状态出现不确定，就选择保守版。</p></div>
    </div>
    <div class="rd-wrap rd-card-grid">
      <article class="rd-card"><span>常规收口</span><h3>班戈 → 纳木措 → 当雄 → 拉萨</h3><p>约400公里、8—10小时。06:30—07:00出发，目标18:00—20:00抵达并按合同还车。</p></article>
      <article class="rd-card rd-card--accent"><span>优先兜底</span><h3>班戈 → 当雄 → 拉萨</h3><p>取消纳木措停留，争取10月6日下午进入拉萨。若有已出票的晚班，可当晚提前返沪。</p></article>
      <article class="rd-card rd-card--night"><span>10月7日返沪</span><h3>拉萨直飞上海</h3><p>2026夏秋航季拉萨至上海虹桥稳定执行，并新增浦东直飞。最终只以国庆实际开售、可退改订单为准。</p></article>
    </div>
  </section>

  <section id="loop-gates" class="rd-section rd-section--night">
    <div class="rd-wrap"><p class="rd-eyebrow">04 / Go or no-go</p><h2>四个决定，<br />守住闭环和返沪。</h2>
      <div class="rd-gates">
        <article><b>01</b><h3>朋友机票先于酒店</h3><p>先锁定10月3日或4日昆莎离港及后续航段；压线方案必须在订单上明确显示10月5日抵达上海。</p></article>
        <article><b>02</b><h3>珠峰和札达可取消</h3><p>任何超时都取消景点停留，不把后续北线压缩为夜驾或连续超长日。</p></article>
        <article><b>03</b><h3>10月6日纳木措可取消</h3><p>11:30仍不能确认开放和日照，直接回拉萨，优先完成还车和返程准备。</p></article>
        <article><b>04</b><h3>两名司机与卫星通信</h3><p>北线服务稀疏，单车至少两名熟练司机、全尺寸备胎、防滑链和卫星通信。</p></article>
      </div>
      <div class="rd-links"><b>原有路线全部保留</b><a href="/hike/travel/ali-grand-loop-2026/">原13天拉萨闭环 ↗</a><a href="/hike/travel/ali-grand-loop-lhasa-lanzhou-2026/">兰州还车版 ↗</a><a href="/hike/travel/ali-central-loop-nagqu-g317-chengdu-2026/">G317成都版 ↗</a></div>
    </div>
  </section>
</RouteGuideShell>
