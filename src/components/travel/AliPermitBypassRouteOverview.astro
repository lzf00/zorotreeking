---
import AliRouteOverview from "./AliRouteOverview.astro";
import {
  aliPermitBypassRoadLabels,
  aliPermitBypassRoutedDayGeometry,
} from "../../data/ali-permit-bypass-road-geometry";
import {
  aliPermitBypassDailyPlanning,
  aliPermitBypassPlanningReviewedAt,
  aliPermitBypassRouteDays,
  aliPermitBypassRoutePoints,
} from "../../data/ali-permit-bypass-route";

const extraSources = [
  {
    href: "https://www.nia.gov.cn/n897453/c1797217/content.html",
    label: "国家移民管理局 · 暂停签发日喀则电子边境通行证",
  },
  {
    href: "https://s.nia.gov.cn/mps/bszy/dzbjtxz/blzy/202604/t20260414_1001.html",
    label: "国家移民管理局 · 电子边境通行证办理",
  },
  {
    href: "https://wlt.xizang.gov.cn/xccx/lytg/202606/t20260612_545303.html",
    label: "西藏自治区文旅厅 · 拉萨至上海直飞航线",
  },
  {
    href: "https://wlt.xizang.gov.cn/xwzx_69/xydt/202507/t20250718_490235.html",
    label: "西藏自治区文旅厅 · 智游阿里预约平台",
  },
  {
    href: "https://nynct.xizang.gov.cn/xwzx/xzsn/202411/t20241106_445729.html",
    label: "西藏自治区农业农村厅 · 洞措乡乡镇住宿资料",
  },
];

const drivingMapPoints = aliPermitBypassRoutePoints.filter((point) => point.id !== "shanghai");
const drivingMapDays = aliPermitBypassRouteDays.filter((day) => day.day < 12);
---

<AliRouteOverview
  points={aliPermitBypassRoutePoints}
  days={aliPermitBypassRouteDays}
  mapPoints={drivingMapPoints}
  mapDays={drivingMapDays}
  dailyPlanning={aliPermitBypassDailyPlanning}
  planningReviewedAt={aliPermitBypassPlanningReviewedAt}
  roadLabels={aliPermitBypassRoadLabels}
  routedDayGeometry={aliPermitBypassRoutedDayGeometry}
  heading="从拉萨出发，绕开日喀则边境，再回到拉萨。"
  intro="新版绕行从 9 月 26 日拉萨取车开始，只办阿里地区电子边境通行证；9 月 28 日经拉孜直达萨嘎，不去定日和珠峰。省下的两天还给塔钦连住和札达过夜，全员 10 月 2 日到狮泉河，G317 只保留色林措和纳木措，10 月 5 日回到拉萨住宿。"
  mapAriaLabel="拉萨取车绕开珠峰经阿里南北线再返回拉萨的交互地图，包含道路拟合、每日路线、补给点和住宿点"
  extraSources={extraSources}
/>
