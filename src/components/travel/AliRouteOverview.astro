---
import AliRouteMap from "./AliRouteMap";
import {
  aliRoadLabels,
  aliRoutedDayGeometry,
  type AliRoadLabel,
} from "../../data/ali-road-geometry";
import {
  aliRouteDays,
  aliRoutePoints,
  type AliRouteDay,
  type AliRouteDailyPlanning,
  type AliRoutePoint,
  type AliRoutePointKind,
} from "../../data/ali-route";

interface Props {
  points?: AliRoutePoint[];
  days?: AliRouteDay[];
  mapPoints?: AliRoutePoint[];
  mapDays?: AliRouteDay[];
  roadLabels?: AliRoadLabel[];
  routedDayGeometry?: Record<number, [number, number][]>;
  heading?: string;
  intro?: string;
  mapAriaLabel?: string;
  extraSources?: { href: string; label: string }[];
  dailyPlanning?: AliRouteDailyPlanning[];
  planningReviewedAt?: string;
}

const {
  points = aliRoutePoints,
  days = aliRouteDays,
  mapPoints = points,
  mapDays = days,
  roadLabels = aliRoadLabels,
  routedDayGeometry = aliRoutedDayGeometry,
  heading = "把每一天，落到真实地理坐标上。",
  intro = "这张可缩放底图把实际道路拟合、公路编号、机场、住宿城市、途经县城、景点、观景位和补给点放在同一条时间线上。点击公路牌或地点标记，可查看对应日期、参考海拔、节点作用和坐标说明。",
  mapAriaLabel,
  extraSources = [],
  dailyPlanning = [],
  planningReviewedAt,
} = Astro.props;
const pointById = new Map(points.map((point) => [point.id, point]));
const planningByDay = new Map(dailyPlanning.map((plan) => [plan.day, plan]));
const mappedPointCount = mapPoints.length;
const peakCount = mapPoints.filter((point) => point.kind === "peak").length;
const attractionCount = mapPoints.filter((point) =>
  point.kind === "attraction" || point.kind === "viewpoint" || point.kind === "peak"
).length;
const overnightCount = mapPoints.filter((point) => point.kind === "overnight").length;
const approximateCount = mapPoints.filter((point) => point.coordinateNote).length;

const allMarkerKinds = [
  { kind: "airport", label: "机场" },
  { kind: "overnight", label: "住宿城市" },
  { kind: "city", label: "途经城市" },
  { kind: "peak", label: "重点峰体" },
  { kind: "attraction", label: "景点" },
  { kind: "viewpoint", label: "观景点" },
  { kind: "supply", label: "补给点" },
] as const satisfies readonly { kind: AliRoutePointKind; label: string }[];
const markerKinds = allMarkerKinds.filter(({ kind }) =>
  mapPoints.some((point) => point.kind === kind)
);
const reservationStatusClass = {
  "必须提前": "required",
  "建议提前": "recommended",
  "现场办理": "onsite",
  "无需预约": "none",
  "出发前复核": "recheck",
} as const;
---

<section id="route-atlas" class="ali-route-atlas">
  <div class="wrap">
    <div class="ali-route-atlas__head reveal">
      <div>
        <div class="eyebrow">01A / Route Atlas</div>
        <div class="rule"></div>
      </div>
      <div>
        <h2>{heading}</h2>
        <p>{intro}</p>
      </div>
    </div>

    <div class="ali-route-atlas__metrics reveal" aria-label="路线地图统计">
      <div><strong>{days.length}</strong><span>逐日路线</span></div>
      <div><strong>{mappedPointCount}</strong><span>地图节点</span></div>
      <div><strong>{attractionCount}</strong><span>{peakCount > 0 ? "景点、观景与峰体" : "景点与观景位"}</span></div>
      <div><strong>{overnightCount}</strong><span>住宿城市</span></div>
    </div>

    <div class="ali-route-atlas__map-card reveal">
      <div class="ali-route-atlas__map-topline">
        <div>
          <span class="ali-route-atlas__live-dot"></span>
          高德地图优先 · 公路走向 · OpenStreetMap 自动备用
        </div>
        <span>WGS84 → GCJ-02 · 规划级坐标 · 非实时导航</span>
      </div>
      <div class="ali-route-atlas__roads" aria-label="本线路主要公路">
        <span>本线公路</span>
        {roadLabels.map((road) => (
          <span class={`ali-route-road-chip ali-route-road-chip--${road.roadClass}`} title={road.description}>
            <strong>{road.ref}</strong>{road.name}
          </span>
        ))}
      </div>
      <AliRouteMap
        client:visible
        points={mapPoints}
        days={mapDays}
        roadLabels={roadLabels}
        routedDayGeometry={routedDayGeometry}
        mapAriaLabel={mapAriaLabel}
      />
      <div class="ali-route-atlas__legend" aria-label="地图图例">
        <span><i class="ali-route-road-swatch"></i>道路拟合</span>
        <span><i class="ali-route-day-swatch"></i>逐日路线</span>
        {markerKinds.map(({ kind, label }) => (
          <span><i class={`ali-route-marker ali-route-marker--${kind}`}></i>{label}</span>
        ))}
        <span class="ali-route-atlas__legend-note">金色实线沿道路网络拟合；红色点线标识每日行驶分段{peakCount > 0 ? "；酒红标记为重点峰体，名字始终显示" : ""}</span>
      </div>
    </div>

    <aside class="ali-route-atlas__notice reveal">
      <strong>读图边界</strong>
      <p>地图标出“计划经过什么、主要沿哪条公路走”，不承诺“当时一定能走”。道路拟合用于行前总览，不包含实时封路、施工、限行或临时改道；其中 {approximateCount} 个湖区、峰体或观景区域使用代表性规划点，并在弹窗中单独注明。出发前 24 小时仍须核对交警通告、景区开放、天气、边境通行证和车载导航。</p>
    </aside>

    <div class="ali-route-atlas__subhead reveal">
      <div>
        <div class="eyebrow">DAY-BY-DAY FIELD INDEX</div>
        <h3>逐日道路、节点、补给与退出条件</h3>
      </div>
      <p>
        公里数与车时是行前估算，未计入临时管制、检查站、排队、拍摄和恶劣天气。
        {planningReviewedAt && <> 预约与住宿信息核对于 {planningReviewedAt}，出发前仍需复核。</>}
      </p>
    </div>

    <div class="ali-route-atlas__days">
      {days.map((day) => {
        const points = day.pointIds
          .map((id) => pointById.get(id))
          .filter((point) => point != null);
        const uniquePoints = points.filter((point, index) => points.findIndex((item) => item.id === point.id) === index);
        const planning = planningByDay.get(day.day);
        return (
          <article class="ali-route-day reveal">
            <div class="ali-route-day__index">
              <b>D{String(day.day).padStart(2, "0")}</b>
              <span>{day.date}</span>
            </div>
            <div class="ali-route-day__body">
              <header>
                <div>
                  <h4>{day.title}</h4>
                  <p>{day.distance} · {day.driving}</p>
                </div>
                <span>{day.roads}</span>
              </header>

              <ol class="ali-route-day__nodes" aria-label={`第 ${day.day} 天途经节点`}>
                {uniquePoints.map((point, index) => (
                  <li>
                    <i class={`ali-route-marker ali-route-marker--${point.kind}`}></i>
                    <span>{point.shortName}</span>
                    {index < uniquePoints.length - 1 && <b aria-hidden="true">→</b>}
                  </li>
                ))}
              </ol>

              <div class="ali-route-day__grid">
                <div><b>沿途重点</b><p>{day.highlights.join(" · ")}</p></div>
                <div><b>补给计划</b><p>{day.supply}</p></div>
                <div><b>住宿落点</b><p>{day.overnight}</p></div>
                <div class="ali-route-day__risk"><b>主要风险</b><p>{day.risk}</p></div>
              </div>

              {planning && (
                <div class="ali-route-day__planning">
                  <section class="ali-route-day__booking" aria-label={`第 ${day.day} 天预约清单`}>
                    <div class="ali-route-day__planning-head">
                      <div>
                        <span>BOOKING AUDIT</span>
                        <h5>当天预约与证件</h5>
                      </div>
                      <small>{planning.reservations.length} 项已逐一核对</small>
                    </div>

                    <div class="ali-route-day__reservation-list">
                      {planning.reservations.map((item) => (
                        <article class="ali-route-reservation">
                          <div class="ali-route-reservation__title">
                            <strong>{item.subject}</strong>
                            <span class={`ali-route-reservation__status ali-route-reservation__status--${reservationStatusClass[item.status]}`}>
                              {item.status}
                            </span>
                          </div>
                          <dl>
                            <div><dt>提前多久</dt><dd>{item.leadTime}</dd></div>
                            <div><dt>办理渠道</dt><dd>{item.channel}</dd></div>
                            <div><dt>随身材料</dt><dd>{item.documents}</dd></div>
                          </dl>
                          <p>{item.note}</p>
                          <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                            {item.sourceLabel} ↗
                          </a>
                        </article>
                      ))}
                    </div>
                  </section>

                  <section class="ali-route-day__stay" aria-label={`第 ${day.day} 天住宿方案`}>
                    <div class="ali-route-day__planning-head">
                      <div>
                        <span>STAY PLAN</span>
                        <h5>{planning.stay.city}</h5>
                      </div>
                      <small>{planning.stay.budget}</small>
                    </div>

                    {planning.stay.noHotelNeeded ? (
                      <div class="ali-route-day__no-hotel">
                        <strong>本日不安排酒店</strong>
                        <p>{planning.stay.bookingAdvice}</p>
                      </div>
                    ) : (
                      <>
                        <div class="ali-route-hotel-list">
                          {planning.stay.hotels.map((hotel, index) => (
                            <a class="ali-route-hotel" href={hotel.bookingUrl} target="_blank" rel="noopener noreferrer">
                              <span>{index === 0 ? "首选" : `备选 ${index}`}</span>
                              <strong>{hotel.name}</strong>
                              <p>{hotel.strengths}</p>
                              <small>查看实时房价与库存 ↗</small>
                            </a>
                          ))}
                        </div>
                        <p class="ali-route-day__stay-advice">{planning.stay.bookingAdvice}</p>
                      </>
                    )}
                  </section>
                </div>
              )}

              <div class="ali-route-day__decision">
                <span>当天退出条件</span>
                <p>{day.decision}</p>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="ali-route-atlas__sources reveal">
      <span>规划资料</span>
      <a href="https://wlt.xizang.gov.cn/xwzx_69/wlyw/wldt/202507/t20250725_491772.html" target="_blank" rel="noopener noreferrer">西藏文旅厅 · 阿里线路与沿途景观 ↗</a>
      <a href="https://wlt.xizang.gov.cn/ztzl_69/wenlv/202512/t20251202_512215.html" target="_blank" rel="noopener noreferrer">西藏文旅厅 · 珠峰地标与开放区域 ↗</a>
      <a href="https://s.nia.gov.cn/mps/bszy/dzbjtxz/blzy/202604/t20260414_1001.html" target="_blank" rel="noopener noreferrer">国家移民管理局 · 电子边境通行证 ↗</a>
      <a href="https://www.peakwiki.org/peak.php?pid=1354" target="_blank" rel="noopener noreferrer">普拉喜琼峰体坐标资料 ↗</a>
      <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap · 道路与底图数据 ↗</a>
      <a href="https://project-osrm.org/" target="_blank" rel="noopener noreferrer">OSRM · 道路拟合引擎 ↗</a>
      <a href="https://lbs.amap.com/api/javascript-api-v2/summary" target="_blank" rel="noopener noreferrer">高德开放平台 · JS API 2.0 ↗</a>
      {extraSources.map((source) => (
        <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .ali-route-atlas {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 92% 4%, rgba(23, 109, 115, .12), transparent 25rem),
      linear-gradient(180deg, #e5ddca 0%, var(--paper) 26%, #ebe4d3 100%);
  }
  .ali-route-atlas__head {
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: 7%;
    align-items: start;
  }
  .ali-route-atlas__head h2 {
    max-width: 780px;
    margin: 0;
  }
  .ali-route-atlas__head p {
    max-width: 760px;
    margin: 18px 0 0;
  }
  .ali-route-atlas__metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 42px;
    border: 1px solid rgba(23, 32, 29, .2);
    background: rgba(240, 234, 220, .62);
  }
  .ali-route-atlas__metrics div {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 18px 22px;
    border-right: 1px solid rgba(23, 32, 29, .16);
  }
  .ali-route-atlas__metrics div:last-child { border-right: 0; }
  .ali-route-atlas__metrics strong {
    color: var(--red);
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1;
  }
  .ali-route-atlas__metrics span {
    color: var(--muted);
    font-size: .76rem;
    letter-spacing: .06em;
  }
  .ali-route-atlas__map-card {
    margin-top: 22px;
    overflow: hidden;
    border: 1px solid rgba(23, 32, 29, .24);
    background: #d8d0bd;
    box-shadow: 0 28px 80px rgba(39, 34, 24, .12);
  }
  .ali-route-atlas__map-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 18px;
    color: #e8e4d6;
    background: #17201d;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .ali-route-atlas__map-topline div {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ali-route-atlas__live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #70c1b3;
    box-shadow: 0 0 0 4px rgba(112, 193, 179, .15);
  }
  .ali-route-atlas__roads {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding: 11px 16px;
    border-bottom: 1px solid rgba(23, 32, 29, .15);
    background: #e7e0d0;
  }
  .ali-route-atlas__roads > span:first-child {
    align-self: center;
    margin-right: 5px;
    color: #6d706b;
    font-family: var(--mono);
    font-size: .62rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .ali-route-road-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 7px 4px 4px;
    border: 1px solid rgba(23, 32, 29, .16);
    border-radius: 3px;
    color: #4c544f;
    background: rgba(255, 252, 243, .78);
    font-size: .66rem;
  }
  .ali-route-road-chip strong {
    padding: 2px 5px;
    border-radius: 2px;
    color: #fff;
    background: #27714c;
    font-family: var(--mono);
    font-size: .62rem;
    letter-spacing: .03em;
  }
  .ali-route-road-chip--expressway strong { background: #176d73; }
  .ali-route-road-chip--scenic strong { background: #b64934; }
  .ali-route-road-chip--connector strong { background: #626a63; }
  .ali-route-map-shell { position: relative; }
  .ali-route-map {
    width: 100%;
    height: min(64vw, 650px);
    min-height: 520px;
    background: #cfc7b4;
  }
  .ali-route-map-help {
    position: absolute;
    z-index: 500;
    right: 12px;
    bottom: 12px;
    margin: 0;
    padding: 8px 10px;
    color: #25302c;
    background: rgba(244, 239, 227, .92);
    border: 1px solid rgba(23, 32, 29, .15);
    font-size: .7rem;
    backdrop-filter: blur(8px);
  }
  .ali-route-map-help strong { color: #176d73; }
  .ali-amap-layer-control {
    position: absolute;
    z-index: 500;
    top: 12px;
    right: 12px;
    margin: 0;
    border: 1px solid rgba(23, 32, 29, .24);
    border-radius: 3px;
    color: #26312c;
    background: rgba(255, 252, 243, .94);
    box-shadow: 0 4px 18px rgba(23, 32, 29, .18);
    font-family: var(--sans);
    font-size: 12px;
  }
  .ali-amap-layer-control summary {
    display: flex;
    min-width: 108px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 8px 12px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
    cursor: pointer;
  }
  .ali-amap-layer-control summary:focus-visible { outline: 3px solid rgba(23, 109, 115, .35); outline-offset: 2px; }
  .ali-amap-layer-control fieldset { display: grid; gap: 3px; margin: 0; border: 0; border-top: 1px solid rgba(23, 32, 29, .16); padding: 6px 10px 9px; }
  .ali-amap-layer-control label { display: flex; min-height: 34px; align-items: center; gap: 7px; white-space: nowrap; }
  .ali-amap-layer-control input { accent-color: #176d73; }
  .ali-route-atlas__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    padding: 14px 18px;
    color: #313a36;
    background: #ede7d9;
    font-size: .74rem;
  }
  .ali-route-atlas__legend > span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .ali-route-atlas__legend-note {
    margin-left: auto;
    color: #6d706b;
  }
  .ali-route-road-swatch,
  .ali-route-day-swatch {
    display: inline-block;
    width: 30px;
    height: 0;
    border-top: 4px solid #d29a33;
    box-shadow: 0 -1px 0 #fff8e9, 0 1px 0 #fff8e9;
  }
  .ali-route-day-swatch {
    border-top: 2px dashed #b64934;
    box-shadow: none;
  }
  .ali-road-shield-icon {
    border: 0;
    background: transparent;
  }
  .ali-road-shield {
    display: inline-flex;
    align-items: center;
    width: max-content;
    max-width: 118px;
    overflow: hidden;
    border: 1px solid rgba(23, 32, 29, .26);
    border-radius: 4px;
    background: rgba(255, 252, 243, .94);
    box-shadow: 0 3px 11px rgba(23, 32, 29, .24);
    white-space: nowrap;
  }
  .ali-road-shield strong {
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    padding: 4px 6px;
    color: #fff;
    background: #27714c;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .04em;
  }
  .ali-road-shield > span {
    overflow: hidden;
    padding: 4px 7px;
    color: #26312c;
    font-size: 10px;
    font-weight: 700;
    text-overflow: ellipsis;
  }
  .ali-road-shield--expressway strong { background: #176d73; }
  .ali-road-shield--scenic strong { background: #b64934; }
  .ali-road-shield--connector strong { background: #626a63; }
  .ali-route-map .leaflet-control-layers {
    border: 1px solid rgba(23, 32, 29, .24);
    border-radius: 3px;
    color: #26312c;
    background: rgba(255, 252, 243, .94);
    box-shadow: 0 4px 18px rgba(23, 32, 29, .18);
    font-family: var(--sans);
  }
  .ali-route-map .leaflet-control-scale-line {
    border-color: #26312c;
    color: #26312c;
    background: rgba(255, 252, 243, .82);
    font-family: var(--mono);
  }
  .ali-route-div-icon {
    border: 0;
    background: transparent;
  }
  .ali-route-marker {
    display: inline-block;
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    border: 2px solid #f4efe3;
    border-radius: 50%;
    background: #17201d;
    box-shadow: 0 1px 5px rgba(23, 32, 29, .28);
  }
  .ali-route-div-icon .ali-route-marker {
    width: 22px;
    height: 22px;
    border-width: 3px;
    box-shadow: 0 2px 8px rgba(23, 32, 29, .38);
  }
  .ali-amap-place-marker {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    width: 22px;
    height: 22px;
  }
  .ali-amap-place-marker--peak {
    width: 26px;
    height: 26px;
  }
  .ali-amap-place-marker .ali-route-marker {
    width: 22px;
    height: 22px;
    border-width: 3px;
    box-shadow: 0 2px 8px rgba(23, 32, 29, .38);
  }
  .ali-route-div-icon--peak .ali-route-marker,
  .ali-amap-place-marker--peak .ali-route-marker {
    width: 26px;
    height: 26px;
    box-shadow: 0 0 0 2px rgba(138, 31, 44, .22), 0 2px 10px rgba(23, 32, 29, .4);
  }
  .ali-amap-place-label {
    position: absolute;
    bottom: 26px;
    left: 50%;
    width: max-content;
    max-width: 110px;
    overflow: hidden;
    padding: 3px 6px;
    border-radius: 2px;
    color: #17201d;
    background: rgba(244, 239, 227, .94);
    box-shadow: 0 2px 12px rgba(23, 32, 29, .18);
    font-size: 11px;
    text-overflow: ellipsis;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .ali-amap-place-label--peak {
    bottom: 32px;
    max-width: none;
    padding: 4px 8px;
    border: 1px solid rgba(138, 31, 44, .35);
    color: #8a1f2c;
    background: rgba(255, 252, 243, .97);
    font-size: 12px;
