---
import "@/styles/fonts.css";
import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ChatLauncher from "@/components/ChatLauncher.astro";
import SearchModal from "@/components/SearchModal";
import ArticleImageLightbox from "@/components/ArticleImageLightbox.astro";
import ReadTracker from "@/components/ReadTracker.astro";
import { resolveSocialImage } from "@/lib/social-image";
import {
  getLangFromUrl,
  hasAlternateLanguagePath,
  pathWithLang,
  useTranslations,
} from "@/i18n/ui";
import { serializeJsonLd } from "@/lib/json-ld";
import { normalizeVerificationToken } from "@/lib/site-verification";
import { breadcrumbJsonLd, buildBreadcrumb } from "@/lib/breadcrumbs";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  // og:image 的实际像素尺寸。默认 1200×630（站点生成的卡片都是这个尺寸）；
  // 相册页直接用原图当封面时必须传真实尺寸，否则平台按错误比例裁切。
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: "website" | "article";
  publishedTime?: Date;     // 文章发布时间（仅 article 用）
  modifiedTime?: Date;
  tags?: string[];          // article:tag
  noindex?: boolean;        // 后台/管理页用
  // 列表型页面（标签页、板块首页、归档页）用 CollectionPage，比裸 WebPage 更准确
  schemaType?: "WebPage" | "CollectionPage";
  // 列表型页面把条目交给 Google：ItemList 让搜索引擎知道这一页列了哪些文章
  listItems?: { name: string; url: string }[];
  // 面包屑末级的名字；默认用 title（例如标签页想要「#photo」而不是「标签: #photo」）
  breadcrumbTitle?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags,
  noindex,
  schemaType = "WebPage",
  listItems,
  breadcrumbTitle,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${t("site.title")}` : `${t("site.title")} — ${t("site.tagline")}`;
const desc = description ?? t("site.description");
// noindex 页（后台、404）不输出 canonical / og:url / 结构化数据：
// 404 页的地址栏路径是假的，之前它把 canonical 指向 https://…/404/，一个不存在的 URL。
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const canonical = noindex ? null : canonicalUrl;
const localPath = Astro.url.pathname
  .replace(/^\/en(\/|$)/, "/")
  .replace(/\/+/g, "/");
const hasLanguageAlternate = hasAlternateLanguagePath(localPath);
const zhAlternate = new URL(pathWithLang(localPath, "zh"), Astro.site).toString();
const enAlternate = new URL(pathWithLang(localPath, "en"), Astro.site).toString();
const googleVerification = normalizeVerificationToken(import.meta.env.PUBLIC_GOOGLE_VERIFICATION);
const baiduVerification = normalizeVerificationToken(import.meta.env.PUBLIC_BAIDU_VERIFICATION);
const bingVerification = normalizeVerificationToken(import.meta.env.PUBLIC_BING_VERIFICATION);

// ── JSON-LD 结构化数据（schema.org） ──
// 让 Google / Bing / 微信分享等理解每个页面的语义。
// Article 页输出 Article，首页输出 WebSite + Person，about 输出不含个人身份的 AboutPage。
const siteName = "ZoroTreeking";
// 页面没给封面图时统一用站点默认卡（public/og-default.png，由
// scripts/generate-og-default.mjs 生成）：分享到微信/Telegram/Slack 时
// 没有 og:image 会退化成一条纯文字链接，点击率差很多。
// 统一在这一层兜底：封面文件不存在（历史遗留的 404 地址）就退默认卡，
// 有 1200×630 的 .og.jpg 派生图就优先用它，避免几个 MB 的原图当分享卡。
const social = resolveSocialImage([ogImage], { width: ogImageWidth, height: ogImageHeight });
const socialImage = social.src;
const author = {
  "@type": "Person",
  name: "Zifei Liu",
  alternateName: "Zoro",
  url: new URL("/about", Astro.site).toString(),
  sameAs: ["https://github.com/lzf00"],
};

let jsonLd: object | null = null;
if (ogType === "article") {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title ?? siteName,
    description: desc,
    image: new URL(socialImage, Astro.site).toString(),
    datePublished: publishedTime?.toISOString(),
    dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
    author,
    publisher: { "@type": "Organization", name: siteName, url: Astro.site?.toString() },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
    keywords: tags?.join(", "),
    inLanguage: lang === "zh" ? "zh-CN" : "en",
  };
} else if (Astro.url.pathname === "/" || Astro.url.pathname === "/en/" || Astro.url.pathname === "/en") {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: Astro.site?.toString(),
    description: t("site.description"),
    inLanguage: lang === "zh" ? "zh-CN" : "en",
    author,
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${Astro.site?.toString().replace(/\/$/, "")}/?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  };
} else if (Astro.url.pathname === "/about" || Astro.url.pathname === "/about/" ||
           Astro.url.pathname === "/en/about" || Astro.url.pathname === "/en/about/") {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: fullTitle,
    description: desc,
    url: canonicalUrl,
    isPartOf: {
      "@type": "WebSite",
      name: siteName,
      url: Astro.site?.toString(),
      inLanguage: lang === "zh" ? "zh-CN" : "en",
    },
    inLanguage: lang === "zh" ? "zh-CN" : "en",
  };
} else {
  // 列表页 / 标签页 / 相册页等没有专属 schema 的页面：补一个 WebPage 或 CollectionPage，
  // 并推导面包屑。此前这些页面（133 个）只有一个裸 WebPage，没有层级信息。
  jsonLd = {
    "@context": "https://schema.org",
    "@type": schemaType,
    name: title ?? siteName,
    description: desc,
    url: canonicalUrl,
    inLanguage: lang === "zh" ? "zh-CN" : "en",
    isPartOf: {
      "@type": "WebSite",
      name: siteName,
      url: Astro.site?.toString(),
      inLanguage: lang === "zh" ? "zh-CN" : "en",
    },
    ...(listItems && listItems.length > 0
      ? {
          mainEntity: {
            "@type": "ItemList",
            numberOfItems: listItems.length,
            itemListElement: listItems.map((item, i) => ({
              "@type": "ListItem",
              position: i + 1,
              name: item.name,
              url: new URL(item.url, Astro.site).toString(),
            })),
          },
        }
      : {}),
  };
}

// 面包屑：文章页由 Breadcrumb.astro 负责，其余页面在这里补，输出成数组里的第二个块。
const sitePrefix = Astro.site?.toString().replace(/\/$/, "") ?? "";
const crumbTrail =
  Astro.url.pathname === "/" || Astro.url.pathname === "/en/"
    ? null
    : buildBreadcrumb({
        pathname: Astro.url.pathname,
        lang,
        title: breadcrumbTitle ?? title ?? siteName,
        labels: {
          home: lang === "zh" ? "首页" : "Home",
          allTags: t("tag.allTags"),
          sections: {
            ai: t("section.ai.title"),
            invest: t("section.invest.title"),
            photo: t("section.photo.title"),
            hike: t("section.hike.title"),
            tag: t("tag.allTags"),
          },
          digest: lang === "zh" ? "日报归档" : "Digest archive",
        },
      });
const jsonLdBlocks: object[] = [];
if (jsonLd) {
  jsonLdBlocks.push(jsonLd);
  if (crumbTrail && crumbTrail.length > 1) {
    jsonLdBlocks.push(breadcrumbJsonLd(crumbTrail, sitePrefix));
  }
}
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Security headers (meta 层；完整版在 nginx 层，见 docs/security-headers.md) */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="format-detection" content="telephone=no,date=no,address=no,email=no" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {hasLanguageAlternate && (
      <>
        <link rel="alternate" hreflang="zh" href={zhAlternate} />
        <link rel="alternate" hreflang="en" href={enAlternate} />
        {/* Google 推荐 x-default：不匹配 zh/en locale 时的兜底，指向中文（主要语言） */}
        <link rel="alternate" hreflang="x-default" href={zhAlternate} />
      </>
    )}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={new URL(socialImage, Astro.site).toString()} />
    {/* og:image:secure_url 部分国内 IM（微信/QQ）显式要 https URL */}
    <meta property="og:image:secure_url" content={new URL(socialImage, Astro.site).toString()} />
    {/* alt 文本帮无障碍 + 部分平台显示 */}
    <meta property="og:image:alt" content={title || siteName} />
    {/* MIME type 帮平台决定是否预览 */}
    <meta property="og:image:type" content={
      socialImage.endsWith(".webp") ? "image/webp"
        : socialImage.endsWith(".png") ? "image/png"
        : "image/jpeg"
    } />
    {/* 1200x630 是 OG / Twitter 推荐尺寸；传了真实尺寸就按真实值输出，
        避免「声明 1200×630、实际 1920×1080」被平台按错误比例裁切 */}
    <meta property="og:image:width" content={String(social.width)} />
    <meta property="og:image:height" content={String(social.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(socialImage, Astro.site).toString()} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {ogType === "article" && tags && tags.map((t) => <meta property="article:tag" content={t} />)}
    {!noindex && jsonLdBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(block)} />
    ))}
    {/* 搜索引擎站长验证（GitHub repo Variables 配后自动注入） */}
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    {baiduVerification && (
      <meta name="baidu-site-verification" content={baiduVerification} />
    )}
    {bingVerification && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1d1d1f" />
    <link rel="alternate" type="application/rss+xml" title="ZoroTreeking · RSS" href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="ZoroTreeking · Atom" href="/atom.xml" />
    <!-- 首次绘制前应用主题，避免深色模式加载时闪白。 -->
    <script is:inline>
      try {
        const stored = localStorage.getItem("theme");
        const initial = stored ?? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.toggle("dark", initial === "dark");
      } catch {}
    </script>
    <!-- editorial 字体组合：Instrument Serif（display）+ Inter（body）+ JetBrains Mono（code）
         全部自托管（public/fonts/ + src/styles/fonts.css，由 scripts/fetch-fonts.ts 生成）：
         fonts.googleapis.com 在大陆经常超时或被墙，第三方 CSS 实测要 550ms+ 才到。 -->
    {/* 不 preload 字体：Lighthouse 限速 1.6Mbps 时，两字体共 63KB 会和 HTML 抢带宽，
        实测让首屏晚 ~300ms。@font-face 都是 font-display: swap，正文先以系统字体绘制，
        字体到货后自行替换，对 FCP 无影响。 */}
  </head>
  <body class="min-h-screen flex flex-col" data-pagefind-ignore={noindex ? true : undefined}>
    <!-- A11y skip-to-content：键盘用户按 Tab 第一个出现这个；视觉默认隐藏，focus 时浮在左上角 -->
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[999]
              focus:px-4 focus:py-2 focus:rounded-lg focus:bg-black focus:text-white
              focus:text-sm focus:font-medium focus:shadow-lg">
      跳到正文 / Skip to content
    </a>
    <Navbar />
    <main id="main-content" class="flex-1" tabindex="-1" data-pagefind-body={!noindex ? true : undefined}>
      <slot />
    </main>
    <Footer />
    <!-- 悬浮 AI 助手：静态按钮，点了才动态 import React 挂件（见 ChatLauncher.astro） -->
    <ChatLauncher />
    <!-- 全站搜索 modal（pagefind，仅在空闲时加载） -->
    <SearchModal client:idle />
    <!-- 文章正文图片 lightbox（点击放大） -->
    <ArticleImageLightbox />
    <!-- "已读"标记：本地 localStorage，列表里淡化已访过的文章 -->
    <ReadTracker />
    <!-- 代码块复制按钮（mdx 文章里的 <pre> 自动加 copy） -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("article pre").forEach((pre) => {
          if (pre.querySelector(".code-copy-btn")) return;
          pre.style.position = "relative";
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "code-copy-btn";
          btn.setAttribute("aria-label", "复制代码");
          btn.textContent = "Copy";
          btn.style.cssText = "position:absolute;top:8px;right:8px;font-size:11px;padding:3px 8px;border-radius:6px;background:rgba(255,255,255,0.08);color:#9ca3af;border:1px solid rgba(255,255,255,0.12);cursor:pointer;font-family:'JetBrains Mono',monospace;opacity:0;transition:opacity 0.15s,background 0.15s";
          pre.addEventListener("mouseenter", () => { btn.style.opacity = "1"; });
          pre.addEventListener("mouseleave", () => { btn.style.opacity = "0"; });
          btn.addEventListener("click", async () => {
            const code = pre.querySelector("code")?.textContent || pre.textContent || "";
            try {
              await navigator.clipboard.writeText(code);
              btn.textContent = "✓ Copied";
              btn.style.color = "#16a34a";
              setTimeout(() => { btn.textContent = "Copy"; btn.style.color = "#9ca3af"; }, 1600);
            } catch {
              btn.textContent = "✗ failed";
              setTimeout(() => { btn.textContent = "Copy"; }, 1600);
            }
          });
          pre.appendChild(btn);
        });
      });
    </script>
    <!-- 轻量页面访问统计：每次浏览发一个 POST，失败静默 -->
    <script is:inline>
      (() => {
        try {
          const path = location.pathname + location.search;
          // referrer 逻辑：外部来源 > URL 里 utm_source（本站内推荐追踪）
          // 内链跳转会带 ?utm_source=related&utm_medium=post-footer，看 admin/stats 就能知道"相关推荐真的被点了几次"
          const httpRef = document.referrer && !document.referrer.includes(location.host) ? document.referrer : null;
          const urlUtm = new URLSearchParams(location.search).get("utm_source");
          const ref = httpRef || (urlUtm ? `internal:${urlUtm}` : null);
          fetch("/api/track", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ path, referrer: ref }),
            keepalive: true,
          }).catch(() => {});
        } catch (_) {}
      })();
    </script>
    {/*
      横向滚动区键盘可达（axe: scrollable-region-focusable）。
      表格、路线图、可打印路书这些容器在窄屏才 overflow，桌面测不出来，
      2026-11 的 390px 巡检一口气抓出 24 张表格 + 3 个自定义滚动区。
      与其在 20 多个标记里各补一遍 tabindex（还会漏掉新加的），
      这里统一给"真的能横向滚动、里面又没有可聚焦元素"的容器补上
      tabindex="0" + role="group" + 名字；窗口尺寸变化时重算。
    */}
    <script is:inline>
      (() => {
        const label = document.documentElement.lang === "en" ? "Scrollable region" : "可横向滚动区域";
        const SEL = "div, section, aside, figure, table, pre, nav";
        const focusableSelector = 'a[href], button, input, select, textarea, summary, [tabindex]:not([tabindex="-1"])';
        const visit = (el) => {
          if (el.dataset.scrollMarked === "done") return;
          // 先做最便宜的判断：真的横向溢出了才继续
          if (el.scrollWidth <= el.clientWidth + 2) return;
          const overflowX = getComputedStyle(el).overflowX;
          if (overflowX !== "auto" && overflowX !== "scroll") return;
          if (el.hasAttribute("tabindex") || el.querySelector(focusableSelector)) {
            el.dataset.scrollMarked = "done";
            return;
          }
          el.setAttribute("tabindex", "0");
          el.setAttribute("role", "group");
          if (!el.getAttribute("aria-label") && !el.getAttribute("aria-labelledby")) {
            el.setAttribute("aria-label", el.dataset.scrollLabel || label);
          }
          el.dataset.scrollMarked = "done";
        };
        const mark = (root) => {
          if (root.nodeType !== 1) return;
          if (root.matches?.(SEL)) visit(root);
          if (root.querySelectorAll) for (const el of root.querySelectorAll(SEL)) visit(el);
        };
        // 第一次全页扫描会强制一次布局：如果在 DOMContentLoaded 里同步跑，
        // 浏览器必须先算完样式和布局才能首绘，FCP 会被推后（2026-11 的 Lighthouse
        // 首页 0.74 就是这么掉的）。放进空闲回调，等首绘之后再扫。
        const idle = (fn) => {
          if ("requestIdleCallback" in window) requestIdleCallback(fn, { timeout: 1500 });
          else setTimeout(fn, 300);
        };
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", () => idle(() => mark(document.body)), { once: true });
        } else {
          idle(() => mark(document.body));
        }
        window.addEventListener("load", () => idle(() => mark(document.body)), { once: true });
        window.addEventListener("resize", () => idle(() => mark(document.body)), { passive: true });
        // React 岛水合后才长出表格的页面（/invest/ 的持仓表就是），首帧扫描时
        // 容器还不溢出，必须等新节点插进来再补一遍；只扫新增子树 + 其祖先链，
        // 避免每次变动都全页重排。
        let timer = 0;
        const pending = new Set();
        const observer = new MutationObserver((records) => {
          for (const record of records) {
            for (const node of record.addedNodes) {
              if (node.nodeType !== 1) continue;
              pending.add(node);
              let parent = node.parentElement;
              while (parent && parent !== document.body) {
                pending.add(parent);
                parent = parent.parentElement;
              }
            }
          }
          if (pending.size === 0) return;
          clearTimeout(timer);
          timer = setTimeout(() => idle(() => {
            for (const root of pending) mark(root);
            pending.clear();
            timer = 0;
          }), 150);
        });
        observer.observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
