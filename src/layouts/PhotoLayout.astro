---
/**
 * 摄影板块专用沉浸式 layout：
 *   - 始终深色背景 (#0a0a0a)，与照片争抢更少
 *   - Navbar 透明，仅在滚动时浮出（沿用全站 sticky）
 *   - Footer 在底部以深色匹配
 *   - 引入 BaseLayout 提供 meta / 字体 / Search / AIWidget
 *
 * 用法：<PhotoLayout title="..." description="..."><slot /></PhotoLayout>
 */
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  // 封面图真实尺寸（相册页直接用原图时必须传，否则平台按 1200×630 裁切）
  ogImageWidth?: number;
  ogImageHeight?: number;
}
const { title, description, ogImage, ogImageWidth, ogImageHeight } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
>
  <div class="photo-immersive">
    <slot />
  </div>
</BaseLayout>

<style is:global>
  /* 沉浸式：在 photo-immersive 包裹的页面内，整页强制深色 */
  body:has(.photo-immersive) {
    background: #0a0a0a !important;
    color: #f0f0f0;
    /* 次级文字在浅色页用 #6e6e73 没问题，但在 #0a0a0a 上只有 3.9:1，
       WCAG AA 要求 4.5:1（相册页 footer 的链接会被 Lighthouse 判失败）。
       提到 #7d7d82 = 4.83:1，仍然明显弱于正文，但过了 AA。 */
    --text-tertiary: #7d7d82;
  }
  body:has(.photo-immersive) header {
    background: rgba(10,10,10,0.7) !important;
    border-bottom-color: rgba(255,255,255,0.08) !important;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  body:has(.photo-immersive) header a,
  body:has(.photo-immersive) header button,
  body:has(.photo-immersive) header span {
    color: #f0f0f0;
  }
  body:has(.photo-immersive) footer {
    background: #0a0a0a;
    border-top-color: rgba(255,255,255,0.08) !important;
    color: rgba(255,255,255,0.55);
  }
  body:has(.photo-immersive) footer a:hover {
    color: #fff !important;
  }
  /* 让 SearchModal / AIChat 圆形按钮在深底上也清晰 */
  body:has(.photo-immersive) header .border {
    border-color: rgba(255,255,255,0.16);
  }
</style>
