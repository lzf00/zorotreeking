---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AliLhasaReturnGuide from "@/components/travel/AliLhasaReturnGuide.astro";

const title = "阿里大环线 · 拉萨取还车 2026";
const description = "9 月 26 日拉萨取车，9 月 29 日住珠峰景区看日落星空，全员 10 月 2 日到狮泉河，G317 经洞措、色林措、班戈、纳木措回拉萨，10 月 5 日住宿。";
const stops = ["拉萨", "日喀则", "定日", "珠峰景区", "萨嘎", "塔钦", "札达", "狮泉河", "洞措", "色林措", "班戈", "纳木措", "拉萨", "上海"];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: title,
  description,
  touristType: "阿里大环线自驾旅行者",
  itinerary: { "@type": "ItemList", itemListElement: stops.map((name, index) => ({ "@type": "ListItem", position: index + 1, name })) },
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script></Fragment>
  <AliLhasaReturnGuide />
</BaseLayout>
