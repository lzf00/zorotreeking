---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getTravelGuides } from "@/data/travel-guides";
import { useTranslations, pathWithLang } from "@/i18n/ui";

const lang = "zh" as const;
const t = useTranslations(lang);
const guides = getTravelGuides(lang);
const destinationFilters = [
  { key: "all", label: "全部路线", count: guides.length },
  { key: "lhasa", label: "拉萨闭环", count: guides.filter((guide) => guide.destination === "lhasa").length },
  { key: "lanzhou", label: "兰州还车", count: guides.filter((guide) => guide.destination === "lanzhou").length },
  { key: "chengdu", label: "成都方向", count: guides.filter((guide) => guide.destination === "chengdu").length },
] as const;
const routeAccents = ["#176d73", "#a94430", "#b57d19", "#315f45", "#76502d", "#425b82"];
const travelStatusLabel = { planning: "规划中" } as const;
const hikes = (await getCollection("hike", (p) => p.data.lang === lang && !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const diffLabel = { easy: "轻松", moderate: "中等", hard: "困难", expert: "专家" };
const diffColor = {
  easy: "bg-green-500/10 text-green-700 dark:text-green-400",
  moderate: "bg-amber-500/10 text-amber-700 dark:text-amber-400",
  hard: "bg-orange-500/10 text-orange-700 dark:text-orange-400",
  expert: "bg-red-500/10 text-red-700 dark:text-red-400",
};
---

<BaseLayout title={t("section.hike.title")} description={t("section.hike.desc")}>
  <section class="travel-hero max-w-6xl mx-auto px-5 pt-12 sm:pt-16 pb-10 sm:pb-14">
    <div class="grid lg:grid-cols-[1fr_280px] gap-8 lg:gap-16 items-end">
      <div>
        <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-[0.2em] text-section-hike">
          <span class="h-px w-10 bg-section-hike"></span>
          Trails · Roadbooks · Field Notes
        </div>
        <h1 class="mt-5 font-serif text-5xl sm:text-7xl lg:text-8xl leading-[0.9] tracking-[-0.045em] text-[var(--text)]">
          徒步<br /><span class="text-section-hike">旅行</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-[var(--text-secondary)]">
          所有自驾路线统一保存在这里。一条路线对应一个独立模块，点击后进入完整地图、逐日行程、住宿预算和行前判断。
        </p>
        <div class="mt-7 flex flex-wrap gap-3 text-sm">
          <a href="#travel-guides" class="rounded-full bg-section-hike px-5 py-2.5 font-medium text-white transition-transform hover:-translate-y-0.5">查看全部自驾路线 ↓</a>
          <a href="#trail-archive" class="rounded-full border border-[var(--border)] px-5 py-2.5 text-[var(--text-secondary)] hover:bg-[var(--bg-soft)]">查看徒步路线</a>
        </div>
      </div>
      <div class="hidden lg:block border-l border-[var(--border)] pl-7 pb-2">
        <div class="text-4xl font-serif text-section-hike">{guides.length + hikes.length}</div>
        <div class="mt-1 text-xs font-mono uppercase tracking-[0.16em] text-[var(--text-tertiary)]">Journeys archived</div>
        <p class="mt-5 text-sm leading-relaxed text-[var(--text-secondary)]">攻略会随路况、季节和实际经验继续修订。</p>
      </div>
    </div>
  </section>

  <section id="travel-guides" class="max-w-6xl mx-auto px-5 pb-16 sm:pb-24 scroll-mt-20">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-[0.18em] text-[var(--text-tertiary)]">Self-drive roadbooks</div>
        <h2 class="mt-1 text-2xl sm:text-3xl font-semibold tracking-tight">自驾路线</h2>
      </div>
      <span class="text-sm text-[var(--text-tertiary)]" data-route-result-count aria-live="polite">{guides.length} 条独立路线</span>
    </div>

    <div class="route-catalog" data-route-catalog>
      <div class="route-filter-bar">
        <div>
          <strong>先选还车 / 离开方向</strong>
          <p>完整行程与返程接驳段已分开标记；所有路线均为规划方案，出发前仍需复核路况、天气、证件和异地还车。</p>
        </div>
        <div class="route-filter-list" role="group" aria-label="按终点筛选自驾路线">
          {destinationFilters.map((filter) => (
            <button
              type="button"
              data-route-filter={filter.key}
              aria-pressed={filter.key === "all" ? "true" : "false"}
            >
              <span>{filter.label}</span><b>{filter.count}</b>
            </button>
          ))}
        </div>
      </div>

      <div class="route-card-grid grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((guide, index) => (
        <a
          href={guide.href}
          class="route-card group"
          style={`--route-accent:${routeAccents[index % routeAccents.length]}`}
          data-route-card={guide.slug}
          data-route-destination={guide.destination}
          data-route-scope={guide.scope}
          aria-label={`打开自驾路线：${guide.title}`}
        >
          <div class="route-card__top">
            <span>ROUTE {String(index + 1).padStart(2, "0")}</span>
            <span>{guide.scopeLabel}</span>
          </div>
          <h3>{guide.title}</h3>
          <p>{guide.description}</p>
          <div class="route-card__path" title={guide.route.join(" → ")}>{guide.route.join(" → ")}</div>
          <div class="route-card__meta">
            <span class="route-card__destination">终点 {guide.destinationLabel}</span>
            <span>{guide.season}</span>
            <span>{guide.days} 天</span>
            <span>约 {guide.distanceKm.toLocaleString()} km</span>
            <span>{guide.travelMode}</span>
          </div>
          <div class="route-card__action">
            <span>打开独立路书</span>
            <small>{travelStatusLabel[guide.status]} · 更新 {guide.updated.slice(5).replace("-", ".")}</small>
            <b aria-hidden="true">↗</b>
          </div>
        </a>
      ))}
      </div>
    </div>
  </section>

  <section id="trail-archive" class="max-w-4xl mx-auto px-5 pb-24 scroll-mt-20">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-[0.18em] text-[var(--text-tertiary)]">Trail Archive</div>
        <h2 class="mt-1 text-2xl sm:text-3xl font-semibold tracking-tight">徒步路线</h2>
      </div>
      <span class="text-sm text-[var(--text-tertiary)]">{hikes.length} 条</span>
    </div>
    {hikes.length === 0 ? <p class="py-12 text-center text-[var(--text-tertiary)]">还没有路线</p> : (
      <ul class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {hikes.map((h) => (
          <li class="py-6 sm:py-7">
            <a href={pathWithLang(`/hike/${h.data.translationKey}`, lang)} class="group grid sm:grid-cols-[150px_1fr_auto] gap-3 sm:gap-6 items-start">
              <div class="text-xs text-[var(--text-tertiary)]">
                <time>{h.data.date.toISOString().slice(0, 10)}</time>
                <div class="mt-1">{h.data.location}</div>
              </div>
              <div>
                <h3 class="text-lg sm:text-xl font-semibold group-hover:text-section-hike transition-colors">{h.data.title}</h3>
                <div class="mt-2 flex flex-wrap items-center gap-3 text-xs text-[var(--text-secondary)]">
                  {h.data.distanceKm != null && <span>{h.data.distanceKm} km</span>}
                  {h.data.elevationGainM != null && <span>+{h.data.elevationGainM} m</span>}
                  {h.data.durationHours != null && <span>{h.data.durationHours} h</span>}
                </div>
              </div>
              <span class:list={["justify-self-start sm:justify-self-end px-2.5 py-1 rounded-full text-xs", diffColor[h.data.difficulty]]}>{diffLabel[h.data.difficulty]}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<script>
  const catalog = document.querySelector<HTMLElement>("[data-route-catalog]");
  const resultCount = document.querySelector<HTMLElement>("[data-route-result-count]");
  if (catalog && resultCount) {
    const buttons = [...catalog.querySelectorAll<HTMLButtonElement>("[data-route-filter]")];
    const cards = [...catalog.querySelectorAll<HTMLElement>("[data-route-card]")];

    const applyFilter = (destination: string) => {
      let visibleCount = 0;
      for (const card of cards) {
        const visible = destination === "all" || card.dataset.routeDestination === destination;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.routeFilter === destination));
      }
      resultCount.textContent = `${visibleCount} 条路线`;
    };

    for (const button of buttons) {
      button.addEventListener("click", () => applyFilter(button.dataset.routeFilter ?? "all"));
    }
  }
</script>

<style>
  .route-filter-bar {
    display: grid;
    grid-template-columns: minmax(220px, .8fr) minmax(420px, 1.2fr);
    gap: 2rem;
    align-items: center;
    margin-bottom: 1.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--bg-soft) 76%, transparent);
  }
  .route-filter-bar strong { display: block; font-size: .88rem; }
  .route-filter-bar p {
    margin: .35rem 0 0;
    color: var(--text-secondary);
    font-size: .73rem;
    line-height: 1.65;
  }
  .route-filter-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .5rem; }
  .route-filter-list button {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: .6rem;
    border: 1px solid var(--border);
    border-radius: .7rem;
    padding: .65rem .75rem;
    color: var(--text-secondary);
    background: var(--bg);
    font-size: .76rem;
    cursor: pointer;
    transition: border-color .2s ease, color .2s ease, background .2s ease;
  }
  .route-filter-list button b {
    color: var(--text-tertiary);
    font: 700 .65rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .route-filter-list button[aria-pressed="true"] {
    border-color: #315f45;
    color: #fff;
    background: #315f45;
  }
  .route-filter-list button[aria-pressed="true"] b { color: #dbe8de; }
  .route-filter-list button:focus-visible { outline: 3px solid color-mix(in srgb, #315f45 35%, transparent); outline-offset: 2px; }
  .route-card {
    position: relative;
    display: flex;
    min-height: 360px;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.35rem;
    padding: 1.55rem;
    color: #17201d;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--route-accent) 9%, transparent), transparent 42%),
      #eee8d9;
    box-shadow: 0 12px 30px rgba(23, 32, 29, .04);
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .route-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--route-accent);
    content: "";
  }
  .route-card[hidden] { display: none; }
  .route-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--route-accent) 45%, #d2c8b4);
    box-shadow: 0 22px 48px rgba(23, 32, 29, .12);
  }
  .route-card:focus-visible { outline: 3px solid var(--route-accent); outline-offset: 4px; }
  .route-card__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--route-accent);
    font: 700 .64rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .route-card h3 {
    margin: 1.45rem 0 0;
    font-family: ui-serif, Georgia, "Noto Serif SC", serif;
    font-size: clamp(1.55rem, 2.2vw, 2rem);
    line-height: 1.08;
    letter-spacing: -.035em;
  }
  .route-card > p { margin: 1rem 0 0; color: #61665f; font-size: .875rem; line-height: 1.75; }
  .route-card__path {
    margin-top: 1.25rem;
    overflow: hidden;
    color: #77796f;
    font-size: .72rem;
    line-height: 1.65;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .route-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem .85rem;
    margin-top: auto;
    padding-top: 1.25rem;
    color: #62685f;
    font: 600 .65rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .route-card__meta .route-card__destination {
    padding: .2rem .4rem;
    border-radius: .25rem;
    color: #fff;
    background: var(--route-accent);
  }
  .route-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .55rem;
    margin-top: 1rem;
    border-top: 1px solid rgba(23, 32, 29, .14);
    padding-top: 1rem;
    color: var(--route-accent);
    font-size: .78rem;
    font-weight: 700;
  }
  .route-card__action small {
    margin-left: auto;
    color: #77796f;
    font: 500 .58rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .route-card__action b { font-size: 1.1rem; transition: transform .25s ease; }
  .route-card:hover .route-card__action b { transform: translate(3px, -3px); }
  @media (prefers-reduced-motion: reduce) {
    .route-card, .route-card__action b, .route-filter-list button { transition: none; }
  }
  @media (max-width: 820px) {
    .route-filter-bar { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (max-width: 520px) {
    .route-filter-bar { padding: .9rem; }
    .route-filter-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .route-card__action small { display: none; }
  }
</style>
