---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import { extractDigestHighlights, extractTLDR } from "@/lib/digest-highlights";
import { lightCover } from "@/lib/cover-src";
import DigestArchiveGrid from "@/components/DigestArchiveGrid.astro";
import { DIGEST_PAGE_SIZE, digestPageCount, counterpartBase, type PaginatedPage } from "@/lib/digest-pagination";

const lang = "zh" as const;
const t = useTranslations(lang);

// 用函数声明（而不是 const 箭头函数）：getStaticPaths 被提到模块顶部执行时，
// 只有函数声明已经初始化完毕，const 还在 TDZ 里。
function isDigest(p: { data: { tags?: string[]; translationKey: string } }): boolean {
  return (p.data.tags ?? []).includes("digest") || p.data.translationKey.startsWith("digest-");
}

/**
 * 分页路由（第 189 轮）。
 *
 * 注意：Astro 会把 `getStaticPaths` **提到模块顶部**执行，所以它不能引用下面那些
 * `const`（会踩 TDZ，报 "digests is not defined"）。这里把取数逻辑内联一份，
 * 渲染时再取一次（`getCollection` 有缓存，代价可以忽略）。
 */
export async function getStaticPaths({ paginate }: { paginate: any }) {
  // 谓词必须内联：Astro 把页面主体包进一个函数，`isDigest` 在 getStaticPaths 里根本看不见
  const items = (await getCollection("ai", (p) => p.data.lang === "zh" && !p.data.draft))
    .filter(
      (p) =>
        (p.data.tags ?? []).includes("digest") || p.data.translationKey.startsWith("digest-"),
    )
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return paginate(items, { pageSize: DIGEST_PAGE_SIZE });
}

const digests = (await getCollection("ai", (p) => p.data.lang === lang && !p.data.draft))
  .filter(isDigest)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 分组与「最新 N 期大卡片 / 更早紧凑行」的渲染在 DigestArchiveGrid 里（第 133 轮）
const FEATURED_COUNT = 6;
// 最新一期那张封面就是首屏 LCP 元素（1200×630 的图，弱网下 lazy 会晚 400 ms+）
const firstCardId = digests[0]?.id;

// 一次渲染全部期数 → 220 KB/DOM 几百行。按 48 期分页，第一页保留"最新 6 期大卡片"。
const { page } = Astro.props as { page: PaginatedPage<(typeof digests)[number]> };
const pageDigests = page.data;
const pageNumber = page.currentPage;
const totalPages = page.lastPage;
/**
 * 语言切换（第 189 轮）。分页页必须和**对端同一页码**互链：
 * `check:lang-switch` 会把"对端存在但没有切换链接"判红，而链到对端不存在的页同样判红
 * （两个语言期数可能不同，所以先算对端页数，够不着就不链）。
 */
const otherCount = (await getCollection("ai", (p) => p.data.lang === "en" && !p.data.draft))
  .filter(isDigest).length;
const otherPages = digestPageCount(otherCount);
const hasCounterpart = otherPages >= pageNumber;
const otherBase = counterpartBase("/ai/digest");

---

<BaseLayout pagefindIgnore={pageNumber > 1}
  title={`AI 每日精选 · 归档`}
  description={`${digests.length} 期自动日报，cron 每日 08:00 抓 HF Daily Papers / arxiv / 量子位 / Anthropic 等`}
  schemaType="CollectionPage"
  listItems={pageDigests.map((d) => ({
    name: d.data.title,
    url: pathWithLang(`/ai/${d.data.translationKey}`, lang),
  }))}
>
  <section class="max-w-3xl mx-auto px-5 pt-12 pb-8">
    <a href={pathWithLang("/ai", lang)}
       class="inline-block text-[11px] uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 hover:text-section-ai transition-colors mb-6">
      ← {t("section.ai.title")}
    </a>
    <div class="text-[11px] uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 font-mono mb-3">Auto Digest</div>
    <h1 class="text-3xl sm:text-5xl leading-tight tracking-tight font-semibold text-section-ai">
      AI 每日精选 · 归档
    </h1>
    <p class="mt-4 text-base sm:text-lg leading-relaxed text-zinc-500 dark:text-zinc-400 font-light">
      {digests.length} 期，cron 每日 08:00 北京自动从 HF Daily Papers / arxiv cs.LG / 量子位 / Anthropic / OpenAI / Google Research 等源抓取，豆包翻译 + AI 摘要。
    </p>
  </section>

  <DigestArchiveGrid
    accent="ai"
    cards={pageDigests.map((d, cardIndex) => {
      // 大卡片只给第一页的最新 6 期；第 2 页起全部走紧凑行
      const rich = pageNumber === 1 && cardIndex < FEATURED_COUNT;
      const tldr = rich ? extractTLDR(d.body ?? "") : null;
      const cover = rich ? lightCover(d.data.cover) : undefined;
      return {
        href: pathWithLang(`/ai/${d.data.translationKey}`, lang),
        title: d.data.title,
        iso: d.data.date.toISOString().slice(0, 10),
        cover,
        summary: tldr?.summary?.[0] ?? undefined,
        highlights: rich && !tldr ? extractDigestHighlights(d.body ?? "", 2) : undefined,
        tags: tldr?.tags?.slice(0, 3),
      };
    })}
    labels={{ featured: "最新 6 期", older: (count) => `更早的日报 · ${count} 期${count}`, empty: "还没有日报" }}
  />

  {hasCounterpart && (
    <p class="max-w-3xl mx-auto px-5 pb-4 text-sm">
      <a
        href={`${otherBase}/${pageNumber === 1 ? "" : `${pageNumber}/`}`}
        class="underline decoration-[var(--border)] hover:decoration-current"
        hreflang={lang === "zh" ? "en" : "zh-CN"}
        lang={lang === "zh" ? "en" : "zh-CN"}
      >{lang === "zh" ? "English" : "中文"}</a>
    </p>
  )}

  {/* 分页导航（第 189 轮）：rel=prev/next 让爬虫按顺序抓，别把它当孤立页 */}
  {totalPages > 1 && (
    <nav class="max-w-3xl mx-auto px-5 pb-16 flex items-center justify-between text-sm" aria-label="归档分页">
      {page.url.prev ? (
        <a class="underline text-[var(--text-secondary)]" rel="prev" href={`${page.url.prev}/`}>← 更新的 {DIGEST_PAGE_SIZE} 期</a>
      ) : (
        <span />
      )}
      <span class="text-[var(--text-tertiary)]">第 {pageNumber} / {totalPages} 页</span>
      {page.url.next ? (
        <a class="underline text-[var(--text-secondary)]" rel="next" href={`${page.url.next}/`}>更早的 {DIGEST_PAGE_SIZE} 期 →</a>
      ) : (
        <span />
      )}
    </nav>
  )}
</BaseLayout>
