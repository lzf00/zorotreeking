---
// 旧地址 /photography/ → /photo/ 的跳转桩。
//
// 之前用 astro.config 的 redirects 生成，Astro 输出的桩是
// `<!doctype html><title>…` —— 没有 <html lang>，axe 报 html-has-lang，
// 而它又因为立刻 meta refresh 跳走、脚本注不进去，全站无障碍审计只能跳过。
// 换成自己的页面：语义完整、可被审计，跳转行为不变。
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="正在前往「影像」" description="旧地址 /photography/ 已迁移到 /photo/。" noindex>
  <meta http-equiv="refresh" content="0;url=/photo/" slot="head" />
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="text-sm text-[var(--text-tertiary)]">正在跳转…</p>
    <h1 class="mt-3 text-2xl font-semibold">这个地址换到 <a class="underline" href="/photo/">/photo/</a> 了</h1>
    <p class="mt-4 text-sm text-[var(--text-secondary)]">如果没有自动跳转，点上面那个链接。</p>
  </section>
</BaseLayout>
