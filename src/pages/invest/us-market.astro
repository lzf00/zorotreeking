---
import BaseLayout from "@/layouts/BaseLayout.astro";
import UsMarketDashboard from "@/components/UsMarketDashboard";
import fallback from "@/data/us-market-latest.json";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import type { UsMarketDashboardData } from "@/lib/us-market";

const lang = "zh" as const;
const t = useTranslations(lang);
---

<BaseLayout
  title="美股与美国经济温度计"
  description="美国 CPI、核心 CPI、非农、失业率与美股大盘、热门行业和大型公司行情"
>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-10 sm:pt-12">
    <header class="mb-7 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <a href={pathWithLang("/invest", lang)} class="text-sm text-section-invest hover:underline">← {t("section.invest.title")}</a>
        <h1 class="mt-3 font-serif text-4xl leading-[0.95] tracking-tight text-[#17324d] dark:text-[#dceaf2] sm:text-5xl">美股观察</h1>
        <p class="mt-2 text-sm text-[var(--text-secondary)]">宏观先行，市场随后。只保留影响判断的核心数字。</p>
      </div>
      <p class="max-w-xs text-[11px] leading-relaxed text-[var(--text-tertiary)] sm:text-right">
        BLS 官方宏观数据 · 美股公开延迟行情<br />自动刷新，缺失数据不估算
      </p>
    </header>

    <UsMarketDashboard initialData={fallback as UsMarketDashboardData} client:load />
  </div>
</BaseLayout>
