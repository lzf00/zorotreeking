---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StarRating from "@/components/StarRating";
import TagChip from "@/components/TagChip.astro";
import PostFooter from "@/components/PostFooter.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import ShareSidebar from "@/components/ShareSidebar";
import SubscribeCTA from "@/components/SubscribeCTA.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import KeyboardNav from "@/components/KeyboardNav.astro";
import { getAdjacentPosts, getRelatedPosts } from "@/lib/related-posts";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import { coverByTranslationKey } from "@/lib/social-image";
import { DIGEST_INVEST_HEADINGS, CONTENT_INVEST_HEADINGS } from "@/lib/prose-headings";
import { digestDescription } from "@/lib/descriptions";

// 日报正文的标题降过一级（h2 分组 / h3 条目），普通文章保持 h1/h2

export async function getStaticPaths() {
  const all = await getCollection("invest", (p) => p.data.lang === "zh" && !p.data.draft);
  return all.map((entry) => ({ params: { slug: entry.data.translationKey }, props: { entry, all } }));
}
// 英文稿是机器翻译产物，部分历史文章没有 cover；同 translationKey 的中文稿有封面时借过来，
// 否则 og:image 会指向一个从没生成过的 /og/invest/<slug>.png（社交卡片直接没有图）。
const coversByKey = coverByTranslationKey(await getCollection("invest"));

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const lang = "zh" as const;
const t = useTranslations(lang);

const { prev, next } = getAdjacentPosts(entry as any, all as any);
const related = getRelatedPosts(entry as any, all as any, 3);
const isDigest = (entry.data.tags ?? []).includes("digest") || entry.data.translationKey.startsWith("digest-");
// 日报正文标题降过一级，普通文章保持原样
const headingClasses = isDigest
  ? DIGEST_INVEST_HEADINGS
  : CONTENT_INVEST_HEADINGS;
// 日报描述改用当天真实的条目标题拼（原来 724 个页面只有 121 种描述，
// 重复最多的一条出现了 129 次），正文没有条目时回退 frontmatter。
const description = (isDigest && digestDescription(entry.body ?? "", "zh", "invest"))
  || entry.data.description;
---

<BaseLayout
  title={entry.data.title}
  description={description}
  ogType="article"
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated}
  tags={entry.data.tags}
  ogImage={entry.data.cover ?? coversByKey.get(entry.data.translationKey) ?? `/og/invest/${entry.data.translationKey}.png`}>
  <ReadingProgress title={entry.data.title} section="invest"
    backHref={pathWithLang("/invest", lang)} backLabel={t("section.invest.title")} />
  <KeyboardNav
    prevHref={prev ? pathWithLang(`/invest/${prev.translationKey}`, lang) : undefined}
    nextHref={next ? pathWithLang(`/invest/${next.translationKey}`, lang) : undefined}
    sectionHref={pathWithLang("/invest", lang)} />
  <ShareSidebar title={entry.data.title}
    url={new URL(Astro.url.pathname, Astro.site).toString()} client:idle />
  <article class="max-w-2xl mx-auto px-6 sm:px-8 pt-12 sm:pt-20 pb-24 sm:pb-32">

    <Breadcrumb section="invest" sectionLabel={t("section.invest.title")}
                isDigest={isDigest} currentTitle={entry.data.title} lang={lang} />

    <header class="mb-14 sm:mb-20">
      <h1 class="text-3xl sm:text-5xl leading-tight tracking-tight font-semibold text-section-invest">
        {entry.data.title}
      </h1>
      {entry.data.description && (
        <p class="mt-5 text-base sm:text-lg leading-relaxed text-zinc-500 dark:text-zinc-400 font-light">
          {entry.data.description}
        </p>
      )}
      <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] uppercase tracking-[0.15em] text-zinc-500 dark:text-zinc-400 font-mono">
        <time>{entry.data.date.toISOString().slice(0, 10)}</time>
        {entry.data.tags.map((tag) => <TagChip tag={tag} lang={lang} />)}
      </div>
    </header>

    <div class={`prose prose-zinc dark:prose-invert max-w-none
                prose-headings:tracking-tight prose-headings:scroll-mt-20
                ${headingClasses}
                prose-a:no-underline prose-a:font-inherit prose-a:text-inherit
                hover:prose-a:underline
                prose-em:not-italic prose-em:text-[11px] prose-em:uppercase
                prose-em:tracking-[0.1em] prose-em:font-mono prose-em:font-normal
                prose-em:text-zinc-500 dark:prose-em:text-zinc-400
                {/* dark: 前缀必须带 prose-em: —— 只写 dark:text-zinc-400 会把颜色设在容器上，
                    em 自己仍是 zinc-500，深色底上 4.09:1 不达标（2026-11 axe 查到，投资日报 718 页） */}
                prose-em:block prose-em:mb-8
                prose-p:text-[17px] sm:prose-p:text-[18px] prose-p:leading-[1.75]
                prose-p:text-zinc-700 dark:prose-p:text-zinc-300
                prose-p:font-normal prose-p:my-6
                prose-blockquote:border-l-2 prose-blockquote:border-zinc-200
                dark:prose-blockquote:border-zinc-800
                prose-blockquote:font-light prose-blockquote:not-italic
                prose-blockquote:text-zinc-500 dark:text-zinc-400 prose-blockquote:my-10
                prose-blockquote:pl-6 prose-blockquote:py-0
                prose-hr:hidden
                prose-pre:bg-[#0d1117] prose-pre:rounded-xl`}>
      <Content />
    </div>

    <div class="mt-24 pt-12 border-t border-zinc-100 dark:border-zinc-800">
      <div class="rounded-2xl border border-[var(--border)] bg-gradient-to-br from-red-50/40 via-transparent to-transparent dark:from-red-950/20 p-6 sm:p-8 text-center">
        <p class="text-sm sm:text-base text-[var(--text-secondary)] mb-3">
          <strong>这篇对你有用吗？</strong> 打个分让我知道下次的方向。
        </p>
        <div class="text-lg">
          <StarRating slug={`invest/${entry.data.translationKey}`} align="center" label="" client:visible />
        </div>
        <p class="mt-3 text-[11px] text-[var(--text-tertiary)] font-mono">
          点星星即可评分 · 数据只保存匿名指纹 + 时间戳
        </p>
      </div>
    </div>

    <SubscribeCTA section="invest" lang={lang} />

    <PostFooter
      prev={prev} next={next} related={related}
      section="invest" lang={lang}
      archiveLabel={isDigest ? "查看全部投资资讯日报" : undefined}
      archiveHref={isDigest ? pathWithLang("/invest/digest", lang) : undefined} />
  </article>
</BaseLayout>
