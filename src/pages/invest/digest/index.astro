---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import { extractDigestHighlights, extractTLDR } from "@/lib/digest-highlights";
import { existsSync } from "node:fs";

const lang = "zh" as const;
const t = useTranslations(lang);

const isDigest = (p: { data: { tags?: string[]; translationKey: string } }) =>
  (p.data.tags ?? []).includes("digest") || p.data.translationKey.startsWith("digest-");

const digests = (await getCollection("invest", (p) => p.data.lang === lang && !p.data.draft))
  .filter(isDigest)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const groups: Record<string, typeof digests> = {};
for (const d of digests) {
  const ym = d.data.date.toISOString().slice(0, 7);
  (groups[ym] ??= []).push(d);
}
const months = Object.keys(groups).sort().reverse();

/**
 * 封面原图是照片站的 OG 图（1200×630、最大 105KB），但卡片只有 430px 宽。
 * `scripts/cover-variants.mjs` 会在旁边生成 640w/960w 两个小图（几 KB），
 * 这里按文件是否存在决定要不要出 srcset——没有变体就回退原图，不会 404。
 */
const coverVariants = (cover: string | undefined) => {
  if (!cover?.startsWith("/photos/")) return null;
  const w640 = cover.replace(/\.(jpe?g|png)$/i, ".w640.jpg");
  const w960 = cover.replace(/\.(jpe?g|png)$/i, ".w960.jpg");
  // 文件名里可能有空格/中文，URL 是转义过的（%20），读盘前还原
  const onDisk = (url: string) => `public${decodeURIComponent(url)}`;
  if (!existsSync(onDisk(w640)) || !existsSync(onDisk(w960))) return null;
  return { w640, w960 };
};
---

<BaseLayout
  title={`投资资讯日报 · 归档`}
  description={`${digests.length} 期自动日报，cron 每日 08:00 抓同花顺 / 东方财富 / Yahoo Finance，AI 改写`}
  schemaType="CollectionPage"
  listItems={digests.map((d) => ({
    name: d.data.title,
    url: pathWithLang(`/invest/${d.data.translationKey}`, lang),
  }))}
>
  <section class="max-w-3xl mx-auto px-5 pt-12 pb-8">
    <a href={pathWithLang("/invest", lang)}
       class="inline-block text-[11px] uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 hover:text-section-invest transition-colors mb-6">
      ← {t("section.invest.title")}
    </a>
    <div class="text-[11px] uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 font-mono mb-3">Auto Digest</div>
    <h1 class="text-3xl sm:text-5xl leading-tight tracking-tight font-semibold text-section-invest">
      投资资讯日报 · 归档
    </h1>
    <p class="mt-4 text-base sm:text-lg leading-relaxed text-zinc-500 dark:text-zinc-400 font-light">
      {digests.length} 期，cron 每日 08:00 北京抓同花顺 7×24、东方财富、Yahoo Finance，AI 改写摘要。<strong>仅作信息整理，不构成投资建议。</strong>
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-5 pb-24">
    {months.map(ym => (
      <div class="mt-12 digest-month">
        <h2 class="text-xs uppercase tracking-[0.2em] text-zinc-600 dark:text-zinc-400 font-mono mb-5 pb-2 border-b border-[var(--border)]">
          {ym}
        </h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {groups[ym].map((d, cardIndex) => {
            const tldr = extractTLDR(d.body ?? "");
            const firstLine = tldr?.summary?.[0] ?? null;
            const tags = tldr?.tags?.slice(0, 3) ?? [];
            const fallbackHighlights = !tldr ? extractDigestHighlights(d.body ?? "", 2) : [];
            const cover = d.data.cover;
            const variants = cover ? coverVariants(cover) : null;
            return (
              <a href={pathWithLang(`/invest/${d.data.translationKey}`, lang)}
                 class="group block rounded-xl overflow-hidden border border-[var(--border)] hover:border-section-invest transition-colors bg-white dark:bg-zinc-900/40">
                {cover && (
                  <div class="aspect-[16/9] overflow-hidden bg-zinc-100 dark:bg-zinc-800">
                    <img
                      src={variants ? variants.w960 : cover}
                      srcset={variants ? `${variants.w640} 640w, ${variants.w960} 960w, ${cover} 1200w` : undefined}
                      sizes="(min-width: 640px) 430px, 100vw"
                      alt={d.data.title}
                      width="1200" height="630"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading={ym === months[0] && cardIndex < 2 ? "eager" : "lazy"}
                      fetchpriority={ym === months[0] && cardIndex < 2 ? "high" : "low"}
                      decoding="async" />
                  </div>
                )}
                <div class="p-4">
                  <time class="text-[10px] uppercase tracking-[0.15em] text-zinc-600 dark:text-zinc-400 font-mono">
                    {d.data.date.toISOString().slice(0, 10)}
                  </time>
                  <h3 class="mt-1 text-base font-semibold leading-snug group-hover:text-section-invest transition-colors line-clamp-2">
                    {d.data.title}
                  </h3>
                  {firstLine && (
                    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-2">
                      {firstLine}
                    </p>
                  )}
                  {!firstLine && fallbackHighlights.length > 0 && (
                    <ul class="mt-2 space-y-0.5">
                      {fallbackHighlights.map(h => (
                        <li class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">· {h}</li>
                      ))}
                    </ul>
                  )}
                  {tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {tags.map(tag => (
                        <span class="text-[10.5px] px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ))}
    {digests.length === 0 && (
      <p class="py-12 text-center text-zinc-500 dark:text-zinc-400">还没有日报</p>
    )}
  </section>
</BaseLayout>
