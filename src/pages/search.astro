---
/**
 * `/search/` 真页面（第 187 轮）。
 *
 * 之前站内搜索只有浮层：`/search/` 直接 404（`docs/known-debt.md` 里挂着的一条），
 * 而且搜到的词没法分享 —— 结果全在 React state 里，刷新一下就没了。
 * 现在这里渲染同一个搜索岛的"页面模式"：输入框铺在页面里、`?q=` 同步进地址栏，
 * 于是 `/search/?q=digest` 这种链接可以复制、收藏、后退。
 *
 * 为什么 noindex：搜索结果页对搜索引擎没有价值（薄内容），而且 pagefind 索引是
 * build 期生成的，爬虫抓到空结果只会浪费预算。它也不在 sitemap 的静态清单里。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchModal from "@/components/SearchModal";
---
<BaseLayout title="搜索" description="全文检索站内文章、AI 日报、投资日报与徒步路线。" noindex>
  <section class="max-w-3xl mx-auto px-5 pt-16 pb-24">
    <h1 class="font-serif text-4xl sm:text-5xl leading-[0.95] tracking-tight mb-3">搜索</h1>
    <p class="text-sm text-[var(--text-tertiary)] mb-8">
      全文检索文章、AI 日报、投资日报与徒步路线。关键词会写进地址栏，可以直接分享或收藏这次搜索。
      在任意页面按 <kbd class="px-1.5 py-0.5 rounded border border-[var(--border)] text-[12px]">/</kbd> 也能唤起浮层搜索。
    </p>

    <SearchModal client:load variant="page" initialOpen />

    <noscript>
      <p class="mt-6 text-sm text-[var(--text-secondary)]">
        搜索需要 JavaScript。没有脚本时，可以从
        <a class="underline" href="/archive/">归档</a>、
        <a class="underline" href="/ai/digest/">AI 日报索引</a>、
        <a class="underline" href="/invest/">投资</a> 手动翻找。
      </p>
    </noscript>
  </section>
</BaseLayout>
