---
/**
 * /now —— "我最近在做什么"
 *
 * 受 Derek Sivers 的 nownownow.com 约定启发：比 About 鲜活、比博客松，
 * 每月 / 每周更新一次手头的事和关注的事。
 *
 * 编辑：直接改这个文件的下方的 sections 数据，然后 push 部署。
 */
import { siteDateString } from "@/lib/site-date";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { readGitLog } from "@/lib/changelog";
import { nowStaleness, recentChanges } from "@/lib/now";

// ──────────────────────────────────────────────────────────────
// 每次更新只需要改这里 —————————————————————————————————
const updated = "2026-07-07";
const sections: Array<{ icon: string; title: string; items: string[] }> = [
  {
    icon: "🏗️",
    title: "在做",
    items: [
      "把 zorotreeking.online 当作个人 PM 演练场：这几周加了 /admin/stats 访问看板、ETF 三因子监测板块、股票详情 6 卡估值 + 基本面",
      "wind-recap 数据流水线加了 <strong>intraday 每小时刷新</strong>：A/H 股 10-16 时整点自动更新",
      "AI 每日精选自动化跑了 2 个月，86 篇 digest 全部补齐 cover + TL;DR + 中英双语",
    ],
  },
  {
    icon: "📚",
    title: "在读 / 在看",
    items: [
      "复盘最近 Wind API 港股 code 归一化坑（<code>700.HK</code> 会 fuzzy 匹配到中国海油）",
      "Anthropic Constitutional AI 相关论文",
      "关于 PEG 数据源的思考：TTM 增长率往往缺失，PEG 得走多路 fallback 或走一致预期",
    ],
  },
  {
    icon: "🤔",
    title: "在思考",
    items: [
      "个人博客用什么比例平衡\"自动 digest\"和\"原创思考\"——现在 AI 版块 53:4 比例失衡",
      "AI 数字工人在中小企业能跑通的最小闭环长什么样",
      "如何让\"数据看板\"感觉更像\"人在写\"：加个人评论、观点标记、投资持仓这种\"你能看到我怎么想\"的锚点",
    ],
  },
  {
    icon: "✋",
    title: "停掉的",
    items: [
      "Twitter / X 重度刷屏（每日 30 分钟封顶）",
      "为了写而写的 \"日更\"——质量门槛比频率重要",
      "过度自动化：意识到全靠自动 digest 塞满会稀释博客的人格声音",
    ],
  },
];
// ──────────────────────────────────────────────────────────────
// 下面全是算出来的，不用手改 —— 手写的那部分会过期，这两块不会。
const todayIso = siteDateString(new Date());
const staleness = nowStaleness(updated, todayIso);
const recent = recentChanges(readGitLog(), { todayIso, days: 30, limit: 5 });
---

<BaseLayout title="Now" description="一份会过期的近况清单：最近在做的项目、在读的书与论文、在用的工具，以及这段时间在想的问题。">
  <div class="max-w-2xl mx-auto px-6 pt-12 sm:pt-20 pb-24">

    <header class="mb-14">
      <p class="text-[11px] uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400 font-mono">/now</p>
      <h1 class="mt-3 font-serif text-4xl sm:text-5xl tracking-tight leading-[1.05]">
        我最近在做什么
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed font-light">
        这一页约定俗成叫 <code class="text-sm">/now</code> ——
        比 <a href="/about/" class="underline hover:no-underline">about</a> 鲜活，
        比博客松，记录此时此刻手头的事和关注的事。
        <a href="https://nownownow.com" rel="external nofollow" class="underline hover:no-underline" target="_blank">了解格式 →</a>
      </p>
      <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400 font-mono">最后更新 · {updated}{staleness.stale && ` · ${staleness.days} 天前`}</p>
      {staleness.notice && (
        <div class="mt-4 rounded-lg border border-amber-300/60 bg-amber-50/70 px-4 py-3 text-sm leading-relaxed text-amber-900 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-200">
          <p>{staleness.notice}</p>
          {/* 光说"过期了"是死路一条：读者要么立刻找到一个能看的地方，要么就走了（第 181 轮） */}
          <p class="mt-2 text-xs">
            能看的地方：
            <a href="/changelog/" class="underline hover:no-underline">更新日志</a>
            <span class="mx-1 opacity-60">·</span>
            <a href="#recent" class="underline hover:no-underline">本页的自动改动</a>
            <span class="mx-1 opacity-60">·</span>
            <a href="/rss.xml" class="underline hover:no-underline">订阅 RSS</a>
          </p>
        </div>
      )}
    </header>

    {recent.length > 0 && (
      <section id="recent" class="mb-12 rounded-xl border border-[var(--border)] px-5 py-5 scroll-mt-24">
        <h2 class="text-[11px] uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400 font-mono mb-3">
          最近 30 天的改动 · 自动生成
        </h2>
        <ul data-pagefind-ignore class="space-y-2">
          {recent.map((c) => (
            <li class="flex items-baseline gap-2 text-sm leading-relaxed">
              <span class="text-[11px] font-mono text-[var(--text-tertiary)] shrink-0">{c.date.slice(5)}</span>
              <span class="text-[11px] font-mono text-[var(--text-tertiary)] shrink-0">{c.label}</span>
              <span class="text-zinc-700 dark:text-zinc-300">{c.subject}</span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-[11px] text-[var(--text-tertiary)]">
          这一块来自 git 历史，不会过期；在 <a href="/changelog/" class="underline hover:no-underline">更新日志</a> 能看到更长的记录。
        </p>
      </section>
    )}

    <div class="space-y-12">
      {sections.map((s) => (
        <section>
          <h2 class="flex items-center gap-3 text-lg font-semibold tracking-tight mb-4">
            <span aria-hidden="true">{s.icon}</span>
            <span>{s.title}</span>
          </h2>
          <ul class="space-y-3 ml-8">
            {s.items.map((item) => (
              <li class="text-[15.5px] leading-[1.75] text-zinc-700 dark:text-zinc-300 relative">
                <span class="absolute -left-5 top-[10px] w-1 h-1 rounded-full bg-zinc-400"></span>
                <Fragment set:html={item} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <footer class="mt-20 pt-8 border-t border-[var(--border)] text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
      <p>
        这是一个 <a href="https://nownownow.com/about" rel="external nofollow" class="underline hover:no-underline" target="_blank">"now" 风格的页面</a>，
        约一个月更新一次。想看更结构化的介绍请看 <a href="/about/" class="underline hover:no-underline">about</a>。
      </p>
    </footer>

  </div>
</BaseLayout>
