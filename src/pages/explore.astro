---
/**
 * /explore 主题地图：把所有文章按 LLM embedding 投影到 2D 平面，
 * 视觉上看到内容的"主题聚类"。
 *
 * - 用豆包 embedding 算的 2048 维向量
 * - PCA 投影到 2D（src/lib/pca.ts，build 时跑约 50ms）
 * - 每个点是一篇文章，颜色对应 collection（AI 蓝 / Invest 红 / Hike 绿）
 * - hover 显示标题，click 跳转文章
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import embeddingsData from "@/data/embeddings.json";
import { projectTo2D } from "@/lib/pca";
import { decodeVector, type StoredCache } from "@/lib/embedding-codec";

interface CacheItem { hash: string; vec: number[] }
const cache = embeddingsData as StoredCache;
const itemsObj = cache.items ?? {};

// 拿所有文章 metadata
const [ai, invest, hike] = await Promise.all([
  getCollection("ai", (p) => p.data.lang === "zh" && !p.data.draft),
  getCollection("invest", (p) => p.data.lang === "zh" && !p.data.draft),
  getCollection("hike", (p) => p.data.lang === "zh" && !p.data.draft),
]);
type Meta = { collection: string; key: string; title: string; date: Date; isDigest: boolean };
const metaMap = new Map<string, Meta>();
const all = [
  ...ai.map((p) => ({ ...p, collection: "ai" })),
  ...invest.map((p) => ({ ...p, collection: "invest" })),
  ...hike.map((p) => ({ ...p, collection: "hike" })),
];
for (const p of all) {
  const isDigest = (p.data.tags ?? []).includes("digest") || p.data.translationKey.startsWith("digest-");
  metaMap.set(`${p.collection}/${p.data.translationKey}`, {
    collection: p.collection, key: p.data.translationKey, title: p.data.title,
    date: p.data.date, isDigest,
  });
}

// 只保留 embeddings 里有的 + 有 metadata 的（JSON 里是 int16+base64，先解码）
const valid: Record<string, CacheItem> = {};
for (const [k, v] of Object.entries(itemsObj)) {
  if (!metaMap.has(k)) continue;
  const vec = decodeVector(v);
  if (vec.length > 0) valid[k] = { hash: v.hash, vec: Array.from(vec) };
}

const points = projectTo2D(valid);

// 显式规格：SVG viewBox -1.05..1.05，留 5% 边距
const VBW = 100, VBH = 100, PAD = 6;
// 坐标保留两位小数：SVG 默认会把 23.123456789012345 这 17 位都写出来，
// 500 个点就是十几 KB 的纯噪声，视觉上两位小数（viewBox 100 单位）已经亚像素级。
const round2 = (n: number) => Math.round(n * 100) / 100;
function toSvg(x: number, y: number): { cx: number; cy: number } {
  return {
    cx: round2(PAD + ((x + 1) / 2) * (VBW - 2 * PAD)),
    cy: round2(PAD + ((1 - y) / 2) * (VBH - 2 * PAD)), // y 翻转：屏幕 y 向下
  };
}

const colorMap: Record<string, string> = {
  ai: "#1d4ed8",
  invest: "#991b1b",
  hike: "#166534",
};

// 手机端：100×100 的 viewBox 里每个点只有 1~2 个 SVG 单位，换算到 412px 宽的屏幕上
// 就是 4~8px 的可点区域——完全没法用手指点（Lighthouse 移动端 tap-targets 只有 0.01）。
// 所以小屏不显示地图，改成一个 44px 行高的列表；地图只在 sm 以上出现。
const COLLECTION_LABEL: Record<string, string> = { ai: "AI", invest: "投资", hike: "徒步" };
const recentTopics = all
  .slice()
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 24)
  .map((p) => ({
    href: `/${p.collection}/${p.data.translationKey}`,
    title: p.data.title,
    date: p.data.date.toISOString().slice(0, 10),
    collection: p.collection,
    color: colorMap[p.collection] ?? "#71717a",
  }));

const stats = {
  total: points.length,
  ai: points.filter((p) => p.key.startsWith("ai/")).length,
  invest: points.filter((p) => p.key.startsWith("invest/")).length,
  hike: points.filter((p) => p.key.startsWith("hike/")).length,
};
---

<BaseLayout title="主题地图 · Explore"
            description={`${stats.total} 篇文章的语义距离投影。AI 蓝 · 投资 红 · 徒步旅行 绿`}>
  <article class="max-w-4xl mx-auto px-6 sm:px-8 pt-12 sm:pt-20 pb-24">

    <header class="mb-10">
      <div class="text-[11px] uppercase tracking-[0.2em] text-zinc-500 font-mono mb-3">EXPLORE</div>
      <h1 class="text-3xl sm:text-5xl leading-tight tracking-tight font-semibold">主题地图</h1>
      <p class="mt-4 text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed font-light">
        全站 {stats.total} 篇文章按 LLM embedding 投影到 2D 平面，相近 = 主题相关。
        靠近的点常常是同主题不同时期的笔记。
      </p>
      <div class="mt-5 flex flex-wrap gap-4 text-xs">
        <span class="inline-flex items-center gap-1.5">
          <i class="w-2.5 h-2.5 rounded-full" style="background:#1d4ed8"></i>
          <span class="text-[var(--text-secondary)]">AI <span class="font-mono text-[var(--text-tertiary)]">{stats.ai}</span></span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <i class="w-2.5 h-2.5 rounded-full" style="background:#991b1b"></i>
          <span class="text-[var(--text-secondary)]">投资 <span class="font-mono text-[var(--text-tertiary)]">{stats.invest}</span></span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <i class="w-2.5 h-2.5 rounded-full" style="background:#166534"></i>
          <span class="text-[var(--text-secondary)]">徒步旅行 <span class="font-mono text-[var(--text-tertiary)]">{stats.hike}</span></span>
        </span>
      </div>
    </header>

    {points.length === 0 ? (
      <p class="text-[var(--text-tertiary)]">embeddings.json 还没数据。等 daily-digest workflow 跑完后回来。</p>
    ) : (
      <div id="explore-map-shell" class="hidden sm:block relative w-full bg-[var(--bg-soft)] rounded-2xl border border-[var(--border)] overflow-hidden">
        <div id="explore-tooltip" role="tooltip" aria-hidden="true"></div>
        <svg id="explore-map" viewBox={`0 0 ${VBW} ${VBH}`} class="w-full h-auto block" preserveAspectRatio="xMidYMid meet" aria-label="文章主题关系图">
          {points.map((p) => {
            const m = metaMap.get(p.key);
            if (!m) return null;
            const { cx, cy } = toSvg(p.x, p.y);
            const color = colorMap[m.collection] ?? "#71717a";
            const r = m.isDigest ? 0.7 : 1.1;
            const opacity = m.isDigest ? 0.55 : 1;
            // digest 的标题里已经含日期，再拼一次会出现 "2026-05-14 · 2026-05-14"
            const dateStr = m.date.toISOString().slice(0, 10);
            const label = m.title.includes(dateStr) ? m.title : `${m.title} · ${dateStr}`;
            // 每节点只留必要属性：class 用 #explore-map a 统一控制，
            // tooltip 文本直接用 aria-label（本来内容一样，复制一份等于白占 45B×500），
            // opacity=1 是默认值就省略。
            return (
              <a href={`/${m.collection}/${m.key}`} class="explore-point" aria-label={label}>
                <circle cx={cx} cy={cy} r={r} fill={color}
                        opacity={opacity === 1 ? undefined : opacity} />
              </a>
            );
          })}
        </svg>
      </div>
    )}

    {/* 小屏：地图上的点太小，改用列表，每行 44px 高 */}
    <div class="sm:hidden">
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-sm font-semibold tracking-tight">最新 24 篇</h2>
        <a href="/tag/" class="inline-flex items-center min-h-6 px-1 -mx-1 text-xs text-[var(--text-secondary)] hover:text-[var(--text)]">全部标签 →</a>
      </div>
      <ul class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {recentTopics.map((t) => (
          <li>
            <a href={t.href} class="flex items-center gap-3 min-h-11 py-2.5">
              <i class="w-2 h-2 rounded-full shrink-0" style={`background:${t.color}`} aria-hidden="true"></i>
              <span class="flex-1 min-w-0 text-sm leading-snug truncate">{t.title}</span>
              <span class="shrink-0 text-[11px] font-mono text-[var(--text-tertiary)]">{t.date.slice(5)}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-[var(--text-tertiary)] leading-relaxed">
        主题地图需要更大的屏幕才能看清点与点的距离，桌面端打开可以看到完整的 {stats.total} 点投影。
      </p>
    </div>

    <section class="mt-8 text-sm text-[var(--text-secondary)] leading-relaxed">
      <p>
        <strong>实现</strong>：每篇文章 (title + description + body 前 800 字) 走豆包 embedding 拿 2048 维向量，
        然后用 PCA (主成分分析) 把所有向量投影到能最大化方差的 2D 平面。距离近的两个点 = 内容语义相似度高。
      </p>
      <p class="mt-3">
        <strong>读法</strong>：
        点击任意点跳到对应文章。空心 / 半透明的小点是 digest（自动日报），实心大点是原创。
        如果某区域聚成一团，那是同主题被反复写到。
      </p>
    </section>

  </article>
</BaseLayout>

<style>
  .explore-point { cursor: pointer; }
  .explore-point circle:hover { r: 2.2; opacity: 1; }
  #explore-tooltip {
    position: absolute;
    z-index: 10;
    max-width: min(320px, calc(100% - 16px));
    padding: 6px 9px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    font-size: 12px;
    line-height: 1.4;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }
  /* 点：过渡与 hover 放大统一在 CSS 里，避免每个 <a>/<circle> 重复携带 class */
  #explore-map a {
    cursor: pointer;
  }
  #explore-map circle {
    transition: r 0.15s ease, opacity 0.15s ease;
  }
  #explore-map a:hover circle,
  #explore-map a:focus-visible circle {
    r: 2;
    opacity: 1;
  }
  #explore-tooltip[data-visible="true"] {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  const shell = document.querySelector<HTMLElement>("#explore-map-shell");
  const map = document.querySelector<SVGElement>("#explore-map");
  const tooltip = document.querySelector<HTMLElement>("#explore-tooltip");

  const pointFrom = (target: EventTarget | null) =>
    target instanceof Element
      ? target.closest<SVGAElement>(".explore-point[aria-label]")
      : null;

  const hideTooltip = () => {
    if (!tooltip) return;
    tooltip.dataset.visible = "false";
    tooltip.setAttribute("aria-hidden", "true");
  };

  const showTooltip = (point: SVGAElement, clientX: number, clientY: number) => {
    if (!shell || !tooltip) return;
    tooltip.textContent = point.getAttribute("aria-label") ?? "";
    tooltip.dataset.visible = "true";
    tooltip.setAttribute("aria-hidden", "false");

    const shellRect = shell.getBoundingClientRect();
    const left = Math.min(
      Math.max(8, clientX - shellRect.left + 12),
      Math.max(8, shell.clientWidth - tooltip.offsetWidth - 8),
    );
    const top = Math.min(
      Math.max(8, clientY - shellRect.top + 12),
      Math.max(8, shell.clientHeight - tooltip.offsetHeight - 8),
    );
    tooltip.style.left = `${left}px`;
    tooltip.style.top = `${top}px`;
  };

  map?.addEventListener("pointerover", (event) => {
    const point = pointFrom(event.target);
    if (point) showTooltip(point, event.clientX, event.clientY);
  });
  map?.addEventListener("pointermove", (event) => {
    const point = pointFrom(event.target);
    if (point) showTooltip(point, event.clientX, event.clientY);
  });
  map?.addEventListener("pointerleave", hideTooltip);
  map?.addEventListener("focusin", (event) => {
    const point = pointFrom(event.target);
    if (!point) return;
    const rect = point.getBoundingClientRect();
    showTooltip(point, rect.left + rect.width / 2, rect.top + rect.height / 2);
  });
  map?.addEventListener("focusout", hideTooltip);
</script>
