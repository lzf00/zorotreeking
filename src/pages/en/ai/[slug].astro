---
import { siteDateString } from "@/lib/site-date";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StarRating from "@/components/StarRating";
import TOC from "@/components/TOC.astro";
import TagChip from "@/components/TagChip.astro";
import Giscus from "@/components/Giscus.astro";
import PostFooter from "@/components/PostFooter.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import ShareSidebar from "@/components/ShareSidebar";
import SubscribeCTA from "@/components/SubscribeCTA.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import KeyboardNav from "@/components/KeyboardNav.astro";
import { estimateReadingTime } from "@/lib/reading-time";
import { getAdjacentPosts, getRelatedPosts } from "@/lib/related-posts";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import { coverByTranslationKey } from "@/lib/social-image";
import { DIGEST_AI_HEADINGS, CONTENT_AI_HEADINGS } from "@/lib/prose-headings";
import { digestDescription, weeklyDescription } from "@/lib/descriptions";
import { coverageNotice, digestCoverage } from "@/lib/digest-coverage";
import { cjkLeaks, untranslatedNotice } from "@/lib/i18n-leaks";

// 日报正文的标题降过一级（h2 分组 / h3 条目），普通文章保持 h1/h2

export async function getStaticPaths() {
  const all = await getCollection("ai", (p) => p.data.lang === "en" && !p.data.draft);
  return all.map((entry) => ({ params: { slug: entry.data.translationKey }, props: { entry, all } }));
}
// 英文稿是机器翻译产物，部分历史文章没有 cover；同 translationKey 的中文稿有封面时借过来，
// 否则 og:image 会指向一个从没生成过的 /og/ai/<slug>.png（社交卡片直接没有图）。
const coversByKey = coverByTranslationKey(await getCollection("ai"));

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const lang = "en" as const;
const t = useTranslations(lang);
const readMins = estimateReadingTime(entry.body ?? "");

const { prev, next } = getAdjacentPosts(entry as any, all as any);
const related = getRelatedPosts(entry as any, all as any, 3);
const isDigest = (entry.data.tags ?? []).includes("digest") || entry.data.translationKey.startsWith("digest-");
// 日报正文标题降过一级，普通文章保持原样
const headingClasses = isDigest
  ? DIGEST_AI_HEADINGS
  : CONTENT_AI_HEADINGS;
// 日报描述改用当天真实的条目标题拼（原来 724 个页面只有 121 种描述，
// 重复最多的一条出现了 129 次），正文没有条目时回退 frontmatter。
const isWeekly = entry.data.translationKey.startsWith("weekly-");
// 周报同理：19 个中文周报原来共用一句「AI 7 · 投资 12 · 徒步 0 · 站长本周观察」
const description =
  (isDigest && digestDescription(entry.body ?? "", "en", "ai", entry.data.date)) ||
  (isWeekly && weeklyDescription(entry.body ?? "", "en")) ||
  entry.data.description;

// 第 120 轮：有 20 期日报整条没有摘要正文，但 feed/描述还在说"AI 摘要"。
// 页面里如实说明一次，比让读者以为是自己的阅读器没渲染出来要好。
const digestCoverageInfo = isDigest ? digestCoverage(entry.body ?? "") : null;
const coverageText = digestCoverageInfo ? coverageNotice(digestCoverageInfo, lang) : null;
// 第 121 轮：英文页里有整段没翻的中文（引用段落 / 链接标题），说清楚它是机翻的
const untranslated = untranslatedNotice(cjkLeaks(entry.body ?? ""));
---

<BaseLayout
  title={entry.data.title}
  description={description}
  ogType="article"
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated}
  tags={entry.data.tags}
  ogImage={entry.data.cover ?? coversByKey.get(entry.data.translationKey) ?? `/og/ai/${entry.data.translationKey}.png`}>
  <ReadingProgress title={entry.data.title} section="ai"
    backHref={pathWithLang("/ai", lang)} backLabel={t("section.ai.title")} />
  <KeyboardNav
    prevHref={prev ? pathWithLang(`/ai/${prev.translationKey}`, lang) : undefined}
    nextHref={next ? pathWithLang(`/ai/${next.translationKey}`, lang) : undefined}
    sectionHref={pathWithLang("/ai", lang)} />
  <ShareSidebar lang="en" title={entry.data.title}
    url={new URL(Astro.url.pathname, Astro.site).toString()} client:idle />
  <TOC headings={headings} label="Contents" />
  <article class="max-w-2xl mx-auto px-6 sm:px-8 pt-12 sm:pt-20 pb-24 sm:pb-32">

    <Breadcrumb section="ai" sectionLabel={t("section.ai.title")}
                isDigest={isDigest} currentTitle={entry.data.title} lang={lang} />

    <header class="mb-14 sm:mb-20">
      <h1 class="text-3xl sm:text-5xl leading-tight tracking-tight font-semibold text-section-ai">
        {entry.data.title}
      </h1>
      {entry.data.description && (
        <p class="mt-5 text-base sm:text-lg leading-relaxed text-zinc-500 dark:text-zinc-400 font-light">
          {entry.data.description}
        </p>
      )}
      <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] uppercase tracking-[0.15em] text-zinc-500 dark:text-zinc-400 font-mono">
        <time>{siteDateString(entry.data.date)}</time>
        <span class="text-zinc-300 dark:text-zinc-700">·</span>
        <span>{readMins} {t("post.readTime")}</span>
        {entry.data.tags.map((tag) => <TagChip tag={tag} lang={lang} />)}
      </div>
    </header>

    <div class={`prose prose-zinc dark:prose-invert max-w-none
                prose-headings:tracking-tight prose-headings:scroll-mt-20
                ${headingClasses}
                prose-a:no-underline prose-a:font-inherit prose-a:text-inherit
                hover:prose-a:underline
                prose-em:not-italic prose-em:text-[11px] prose-em:uppercase
                prose-em:tracking-[0.1em] prose-em:font-mono prose-em:font-normal
                prose-em:text-zinc-500 dark:prose-em:text-zinc-400
                prose-em:block prose-em:mb-8
                prose-p:text-[17px] sm:prose-p:text-[18px] prose-p:leading-[1.75]
                prose-p:text-zinc-700 dark:prose-p:text-zinc-300
                prose-p:font-normal prose-p:my-6
                prose-blockquote:border-l-2 prose-blockquote:border-zinc-200
                dark:prose-blockquote:border-zinc-800
                prose-blockquote:font-light prose-blockquote:not-italic
                prose-blockquote:text-zinc-500 dark:text-zinc-400 prose-blockquote:my-10
                prose-blockquote:pl-6 prose-blockquote:py-0
                prose-hr:hidden
                prose-pre:bg-[#0d1117] prose-pre:rounded-xl`}>
      {untranslated && (
        <p class="not-prose mb-6 rounded-xl border border-sky-400/50 bg-sky-50/70 px-4 py-3 text-[13px] leading-relaxed text-sky-900 dark:border-sky-500/40 dark:bg-sky-500/10 dark:text-sky-200">
          {untranslated}
        </p>
      )}
      {coverageText && (
        <p class="not-prose mb-8 rounded-xl border border-amber-400/50 bg-amber-50/70 px-4 py-3 text-[13px] leading-relaxed text-amber-800 dark:border-amber-500/40 dark:bg-amber-500/10 dark:text-amber-300">
          {coverageText}
        </p>
      )}
      <Content />
    </div>

    <div class="mt-24 pt-12 border-t border-zinc-100 dark:border-zinc-800">
      <div class="rounded-2xl border border-[var(--border)] bg-gradient-to-br from-blue-50/40 via-transparent to-transparent dark:from-blue-950/20 p-6 sm:p-8 text-center">
        <p class="text-sm sm:text-base text-[var(--text-secondary)] mb-3">
          <strong>Was this useful?</strong> A rating helps me pick the next topic.
        </p>
        <div class="text-lg">
          <StarRating lang="en" slug={`ai/${entry.data.translationKey}`} align="center" label="" client:visible />
        </div>
        <p class="mt-3 text-[11px] text-[var(--text-tertiary)] font-mono">
          Click a star to rate · Only anonymous fingerprint + timestamp stored
        </p>
      </div>
    </div>

    <SubscribeCTA section="ai" lang={lang} />

    <PostFooter
      prev={prev} next={next} related={related}
      section="ai" lang={lang}
      archiveLabel={isDigest ? "Browse all AI daily digests" : undefined}
      archiveHref={isDigest ? pathWithLang("/ai/digest", lang) : undefined} />

    <Giscus />
  </article>
</BaseLayout>
