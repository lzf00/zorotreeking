---
import { getCollection } from "astro:content";
import PhotoLayout from "@/layouts/PhotoLayout.astro";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import { sectionDescription } from "@/lib/descriptions";
import { loadPhotoManifest, resolveAlbumKey } from "@/lib/photo-manifests";

const lang = "en" as const;
const t = useTranslations(lang);

const albums = (await getCollection("photo", (p) => p.data.lang === lang && !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const enriched = albums.map((album) => {
  const manifest = loadPhotoManifest(resolveAlbumKey(album.data));
  // 别用裸 `manifest[0].src`：那是原图（实测有一张 3.7 MB 的 JPEG），
  // 列表卡片只有几百 px 宽，直接下原图会把整页干到 4 MB。优先拿 webp 派生图。
  const first = manifest[0];
  const cover = first ?? null;
  return { album, cover, count: manifest.length };
});

function colSpan(i: number) {
  return i % 3 === 0 ? "lg:col-span-2" : "lg:col-span-1";
}
function aspect(i: number) {
  return i % 3 === 0 ? "aspect-[16/9]" : "aspect-[4/5]";
}
---

<PhotoLayout
  title={t("section.photo.title")}
  description={sectionDescription(
    "photo",
    {
      count: enriched.length,
      photos: enriched.reduce((sum, a) => sum + a.count, 0),
      latest: albums[0] ? { title: albums[0].data.title, date: albums[0].data.date } : undefined,
    },
    lang,
  )}
  schemaType="CollectionPage"
>
  <section class="max-w-6xl mx-auto px-5 pt-16 sm:pt-24 pb-12 text-center">
    <p class="text-[11px] uppercase tracking-[0.22em] text-white/55 font-mono">{enriched.length} albums</p>
    <h1 class="mt-4 font-serif text-5xl sm:text-7xl leading-[0.95] tracking-tight text-white">{t("section.photo.title")}</h1>
    <p class="mt-4 text-base sm:text-lg text-white/65 max-w-xl mx-auto leading-relaxed">{t("section.photo.desc")}</p>
    <p class="mt-5 text-sm leading-relaxed text-white/55 max-w-xl mx-auto">
      Albums are grouped by subject and each cover is the album's first frame. Open one to page through the photos
      and see where and when they were taken; the count tells you how long the set is.
    </p>
    <p class="mt-2 text-sm leading-relaxed text-white/55 max-w-xl mx-auto">
      Follow along via <a href="/rss.xml" class="underline decoration-1 underline-offset-2 hover:text-white/60">RSS</a>,
      or browse the
      <a href="/en/tag/photo/" class="underline decoration-1 underline-offset-2 hover:text-white/60">#photo tag</a>.
    </p>
  </section>

  <section class="max-w-7xl mx-auto px-2 sm:px-3 pb-24">
    {enriched.length === 0 ? (
      <div class="py-24 text-center text-white/55">
        <p class="font-serif text-2xl mb-3">No albums yet</p>
        <p class="text-sm leading-relaxed max-w-md mx-auto">
          Open <a href="/admin" class="underline hover:text-white">/admin</a> → Photo album,
          fill the title and album ID, drag your photos into the media library.
          Deploy will extract EXIF and build the gallery automatically.
        </p>
      </div>
    ) : (
      <h2 class="sr-only">All albums</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-3">
        {enriched.map(({ album, cover, count }, i) => (
          <li class={colSpan(i)}>
            <a href={pathWithLang(`/photo/${album.data.translationKey}`, lang)} class="group relative block overflow-hidden bg-neutral-900">
              <div class={`${aspect(i)} overflow-hidden`}>
                {cover ? (
                  <picture>
                    {/* 桌面用 1600px 的 hero 变体（2x 屏的 2 列卡片需要 ~1600px），
                        手机用 720px 缩略图；两个 source 各有 media，弱屏不会下大图。
                        （反例：两个 source 都不带 media 时，浏览器只认第一个，第二个是死代码。）
                        没有 hero 变体的（原图 ≤1600 宽）退回原尺寸 webp。 */}
                    {(cover.heroWebp || cover.srcWebp) && (
                      <source
                        type="image/webp"
                        media="(min-width: 1024px)"
                        srcset={cover.heroWebp ?? cover.srcWebp}
                        sizes="(min-width: 1024px) 40vw"
                      />
                    )}
                    {(cover.thumbWebp || cover.heroWebp || cover.srcWebp) && (
                      <source
                        type="image/webp"
                        srcset={cover.thumbWebp ?? cover.heroWebp ?? cover.srcWebp}
                        sizes="100vw"
                      />
                    )}
                    <img
                      src={cover.srcOg ?? cover.src}
                      alt={album.data.title}
                      width={cover.width || undefined}
                      height={cover.height || undefined}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-[800ms] ease-out group-hover:scale-[1.04]"
                    />
                  </picture>
                ) : (
                  <div class="w-full h-full grid place-items-center text-white/30 text-4xl font-serif">·</div>
                )}
              </div>
              <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5 transition-all duration-300" style="background: linear-gradient(to top, rgba(0,0,0,0.78), rgba(0,0,0,0))">
                <h3 class="font-serif text-xl sm:text-2xl leading-tight text-white">{album.data.title}</h3>
                <div class="mt-1 flex items-center gap-2 text-[10.5px] uppercase tracking-[0.14em] font-mono text-white/65">
                  <time>{album.data.date.toISOString().slice(0, 10)}</time>
                  <span class="opacity-50">/</span>
                  <span>{count} frames</span>
                  {album.data.location && <><span class="opacity-50">/</span><span class="normal-case tracking-normal">{album.data.location}</span></>}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</PhotoLayout>
