---
import { siteDateString } from "@/lib/site-date";
import { getCollection, render } from "astro:content";
import PhotoLayout from "@/layouts/PhotoLayout.astro";
import FeedbackButtons from "@/components/FeedbackButtons";
import PhotoGallery from "@/components/PhotoGallery";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import PhotoMap from "@/components/PhotoMap";
import { heroSrcSets } from "@/lib/photo-hero";
import { loadPhotoManifest, photoAlt, resolveAlbumKey } from "@/lib/photo-manifests";
import { pickAlbumCover } from "@/lib/photo-cover";

export async function getStaticPaths() {
  const all = await getCollection("photo", (p) => p.data.lang === "en" && !p.data.draft);
  return all.map((entry) => ({ params: { slug: entry.data.translationKey }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const lang = "en" as const;
const t = useTranslations(lang);
const photos = loadPhotoManifest(resolveAlbumKey(entry.data));
// 与中文相册页共用一个选封面的函数（英文页原先写死 photos[0]，导致同一本相册
// 中英文首图不同，且 baokemeng 英文页首图下了 85 KB 原图、中文页只有 9 KB hero）
const { cover, rest } = pickAlbumCover(entry.data.cover, photos, entry.data.title);
const heroSets = heroSrcSets(cover);
// 有 GPS 的照片提出来给地图用（中文页早就有，英文页一直缺，这次补齐）
const geoPoints = photos
  .filter((p: any) => Number.isFinite(p.lat) && Number.isFinite(p.lng))
  .map((p: any) => ({ lat: p.lat, lng: p.lng, thumb: p.thumb, alt: p.alt, src: p.src }));
const dateStr = siteDateString(entry.data.date);
// 与中文相册页保持一致：优先 1200×630 派生图，否则用原图 + 真实尺寸。
const shareImage = cover?.srcOg ?? cover?.src;
const shareDims = cover?.srcOg
  ? undefined
  : cover?.width && cover?.height
    ? { ogImageWidth: cover.width, ogImageHeight: cover.height }
    : undefined;
---

<PhotoLayout title={entry.data.title} description={entry.data.description}
             ogImage={shareImage} {...shareDims}>
  <div class="max-w-7xl mx-auto px-5 pt-6">
    <a href={pathWithLang("/photo", lang)} class="text-xs uppercase tracking-[0.18em] text-white/55 hover:text-white transition-colors">
      ← {t("section.photo.title")}
    </a>
  </div>

  {cover && (
    <section class="mt-6 mb-10">
      <div class="w-full bg-black overflow-hidden">
        {/* 与中文相册页一致：内在宽高防 CLS，webp 降 LCP 字节。
            原图绝不能写成 srcOg —— 那是 1200×630 的社交卡片裁切图，浏览器不支持
            webp 时会显示一张被裁过、却按原图宽高占位的图（第 52 轮修）。 */}
        <picture>
          {/* 与中文相册页一致：手机上用 720px 缩略图（28 KB），桌面用原尺寸 webp */}
          {heroSets.mobile && <source type="image/webp" media="(max-width: 640px)" srcset={heroSets.mobile} sizes="100vw" />}
          {heroSets.wide && <source type="image/webp" srcset={heroSets.wide} sizes="100vw" />}
          <img
            src={cover.src}
            alt={photoAlt(cover, "en")}
            width={cover.width || undefined}
            height={cover.height || undefined}
            class="w-full h-auto max-h-[88vh] object-contain mx-auto block"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </section>
  )}

  <header class="max-w-3xl mx-auto px-5 text-center pb-2">
    <h1 class="font-serif text-4xl sm:text-6xl leading-[1.05] tracking-tight text-white">{entry.data.title}</h1>
    {entry.data.description && <p class="mt-4 text-base sm:text-lg text-white/65 leading-relaxed max-w-2xl mx-auto">{entry.data.description}</p>}
    <div class="mt-6 inline-flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-[11px] uppercase tracking-[0.16em] text-white/55 font-mono">
      <time>{dateStr}</time>
      {entry.data.location && <><span class="opacity-50">/</span><span>{entry.data.location}</span></>}
      {entry.data.cameraSummary && <><span class="opacity-50">/</span><span>{entry.data.cameraSummary}</span></>}
      <span class="opacity-50">/</span><span>{photos.length} frames</span>
    </div>
  </header>

  {(entry.body ?? "").trim().length > 0 && (
    <section class="max-w-prose mx-auto px-5 mt-10 mb-12 text-[15.5px] leading-[1.85] text-white/75">
      <Content />
    </section>
  )}

  {rest.length > 0 ? (
    <section class="max-w-7xl mx-auto px-2 sm:px-3 mt-12">
      <PhotoGallery photos={rest} galleryId={`gallery-${entry.data.translationKey}`} lang="en" client:load />
    </section>
  ) : null}

  {/* GPS 地图（与中文页对齐） */}
  {geoPoints.length > 0 ? (
    <section class="max-w-5xl mx-auto px-5 mt-12">
      <PhotoMap points={geoPoints} client:visible />
    </section>
  ) : photos.length === 0 ? (
    <section class="max-w-2xl mx-auto px-5 mt-16 mb-24 text-center text-white/55">
      <p class="font-mono text-sm">No photos uploaded yet.</p>
      <p class="mt-2 text-sm">
        Open <code class="text-white/80">/admin</code> → Photo album, edit this entry,
        and drag your images into the media library. Deploy will publish them automatically.
      </p>
    </section>
  ) : null}

  <section class="max-w-3xl mx-auto px-5 mt-20 pb-24 text-center">
    <div class="inline-block">
      <FeedbackButtons lang="en" slug={`photo/${entry.data.translationKey}`} client:idle />
    </div>
    <div class="mt-10">
      <a href={pathWithLang("/photo", lang)} class="text-xs uppercase tracking-[0.18em] text-white/55 hover:text-white transition-colors">
        ← {t("section.photo.title")}
      </a>
    </div>
  </section>
</PhotoLayout>

<style is:global>
  /* 深底相册页里让 feedback 图标跟随底色（中文页有、英文页漏了） */
  body:has(.photo-immersive) .photo-immersive [data-feedback="like"],
  body:has(.photo-immersive) .photo-immersive [data-feedback="dislike"],
  body:has(.photo-immersive) .photo-immersive [aria-label="Like"],
  body:has(.photo-immersive) .photo-immersive [aria-label="Dislike"] {
    color: rgba(255,255,255,0.7);
  }
</style>
