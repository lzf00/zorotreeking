---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildTagIndex, recentInSection, relatedTags, tagSections, tagToSlug } from "@/lib/tags";
import { MAX_TAG_ITEMLIST, tagStats } from "@/lib/tag-relations";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import { tagDescription } from "@/lib/descriptions";
import TagIntro from "@/components/TagIntro.astro";

export async function getStaticPaths() {
  const lang = "en" as const;
  const { tags } = await buildTagIndex(lang);
  return tags.map(({ tag, posts }) => ({
    params: { tag: tagToSlug(tag) },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props as {
  tag: string;
  posts: Array<{ section: "ai" | "invest" | "photo" | "hike"; slug: string; title: string; description?: string; date: Date; tags: string[] }>;
};
const lang = "en" as const;
const t = useTranslations(lang);
const description = tagDescription(tag, posts, lang);
const related = relatedTags(tag, posts);
const sections = tagSections(posts);
const stats = tagStats(posts);
// 只有一两篇内容的标签页正文很短，补一块「同栏目最近文章」，避免成为纯列表空页
const more = posts.length < 3 && posts[0]
  ? await recentInSection(lang, posts[0].section, 5, posts.map((p) => p.slug))
  : [];

const sectionColor: Record<string, string> = {
  ai: "text-section-ai",
  invest: "text-section-invest",
  photo: "text-section-photo",
  hike: "text-section-hike",
};
const sectionLabel: Record<string, string> = {
  ai: t("section.ai.title"),
  invest: t("section.invest.title"),
  photo: t("section.photo.title"),
  hike: t("section.hike.title"),
};

/** 最新多少篇带摘要；更早的走紧凑行（第 134 轮） */
const DETAILED_COUNT = 20;
---

<BaseLayout
  title={`${t("tag.title")}: #${tag}`}
  description={description}
  schemaType="CollectionPage"
  breadcrumbTitle={`#${tag}`}
  listItems={posts.slice(0, MAX_TAG_ITEMLIST).map((post) => ({
    name: post.title,
    url: pathWithLang(`/${post.section}/${post.slug}`, lang),
  }))}
>
  <section class="max-w-3xl mx-auto px-5 pt-12 pb-6">
    <a href={pathWithLang("/tag", lang)} class="text-sm text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]">← {t("tag.allTags")}</a>
    <h1 class="mt-2 font-serif text-5xl sm:text-6xl leading-[0.95] tracking-tight">#{tag}</h1>
    <p class="mt-2 text-sm text-[var(--text-tertiary)]">
      {posts.length} {posts.length === 1 ? t("tag.countOne") : t("tag.count")}
    </p>
    <TagIntro tag={tag} lang={lang} sections={sections} related={related} count={posts.length} from={stats.from} to={stats.to} bySection={stats.bySection} />
  </section>
  <section class="max-w-3xl mx-auto px-5">
    {/* 第 134 轮：一个标签下可能有 300+ 篇（#auto 3400 个标签、31 KB gzip），
        全部带摘要渲染既费 DOM 也费字节。最新 20 篇保留板块/日期/摘要，
        更早的只留日期 + 标题 —— 链接一条不少，只是不再带摘要。 */}
    <ul class="divide-y divide-[var(--border)]">
      {posts.slice(0, DETAILED_COUNT).map((p) => (
        <li class="py-5">
          <div class="flex items-center gap-2 text-xs text-[var(--text-tertiary)] mb-1">
            <span class={sectionColor[p.section]}>{sectionLabel[p.section]}</span>
            <span>·</span>
            <time datetime={p.date.toISOString().slice(0, 10)}>{p.date.toISOString().slice(0, 10)}</time>
          </div>
          <h2 class="text-lg font-semibold">
            <a href={pathWithLang(`/${p.section}/${p.slug}`, lang)}
               class={`transition-colors hover:${sectionColor[p.section]}`}>
              {p.title}
            </a>
          </h2>
          {p.description && <p class="mt-1 text-sm text-[var(--text-secondary)] line-clamp-2">{p.description}</p>}
        </li>
      ))}
      {posts.slice(DETAILED_COUNT).map((p) => (
        <li>
          <a href={pathWithLang(`/${p.section}/${p.slug}`, lang)}
             class="group flex items-baseline gap-3 py-2 text-sm transition-colors hover:text-[var(--text-secondary)]">
            <time class="shrink-0 font-mono text-xs text-[var(--text-tertiary)]" datetime={p.date.toISOString().slice(0, 10)}>
              {p.date.toISOString().slice(0, 10)}
            </time>
            <span class={`shrink-0 text-xs ${sectionColor[p.section]}`}>{sectionLabel[p.section]}</span>
            <span class="min-w-0 flex-1 truncate group-hover:underline">{p.title}</span>
          </a>
        </li>
      ))}
      {posts.length === 0 && <li class="py-12 text-center text-[var(--text-tertiary)]">{t("tag.empty")}</li>}
    </ul>
  </section>
  {more.length > 0 && (
    <section class="max-w-3xl mx-auto px-5 pb-16">
      <h2 class="text-base font-semibold tracking-tight mb-3">
        More from {t(`section.${posts[0].section}.title`)}
      </h2>
      <ul class="divide-y divide-[var(--border)] border-t border-[var(--border)]">
        {more.map((m) => (
          <li class="py-3">
            <a href={pathWithLang(`/${m.section}/${m.slug}`, lang)} class="group flex items-baseline justify-between gap-4">
              <span class="min-w-0 text-sm font-medium group-hover:text-[var(--text-secondary)]">{m.title}</span>
              <time class="shrink-0 text-xs text-[var(--text-tertiary)] font-mono">{m.date.toISOString().slice(0, 10)}</time>
            </a>
          </li>
        ))}
      </ul>
      <a href={pathWithLang(`/${posts[0].section}`, lang)} class="mt-4 inline-block text-xs text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]">
        All {t(`section.${posts[0].section}.title`)} →
      </a>
    </section>
  )}
</BaseLayout>
