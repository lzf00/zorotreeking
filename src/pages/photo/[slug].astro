---
import { getCollection, render } from "astro:content";
import PhotoLayout from "@/layouts/PhotoLayout.astro";
import FeedbackButtons from "@/components/FeedbackButtons";
import PhotoGallery from "@/components/PhotoGallery";
import PhotoMap from "@/components/PhotoMap";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import { loadPhotoManifest, resolveAlbumKey } from "@/lib/photo-manifests";
import { siteDateString } from "@/lib/site-date";

export async function getStaticPaths() {
  const all = await getCollection("photo", (p) => p.data.lang === "zh" && !p.data.draft);
  return all.map((entry) => ({
    params: { slug: entry.data.translationKey },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const lang = "zh" as const;
const t = useTranslations(lang);
const photos = loadPhotoManifest(resolveAlbumKey(entry.data));
// hero 优先用 frontmatter.cover；找不到对应 manifest 条目时退化成裸路径
const coverPick = (() => {
  if (!entry.data.cover) return photos[0];
  const hit = photos.find((p) => p.src === entry.data.cover || p.thumb === entry.data.cover);
  return hit ?? { src: entry.data.cover, thumb: entry.data.cover, alt: entry.data.title, width: 0, height: 0 };
})();
const cover = coverPick;
const rest = photos.filter((p) => p.src !== cover?.src);
// 社交卡片优先用 1200×630 的 .og.jpg 派生图（体积小、比例对）；没有派生图时
// 退回原图，但必须把真实宽高一并传下去，否则平台按 1200×630 裁切会变形。
const shareImage = cover?.srcOg ?? entry.data.cover ?? cover?.src;
const shareDims = cover?.srcOg
  ? undefined
  : cover?.width && cover?.height
    ? { ogImageWidth: cover.width, ogImageHeight: cover.height }
    : undefined;
const dateStr = siteDateString(entry.data.date);
// 有 GPS 的照片提出来给地图用
const geoPoints = photos
  .filter((p: any) => Number.isFinite(p.lat) && Number.isFinite(p.lng))
  .map((p: any) => ({ lat: p.lat, lng: p.lng, thumb: p.thumb, alt: p.alt, src: p.src }));
---

<PhotoLayout title={entry.data.title} description={entry.data.description}
             ogImage={shareImage} {...shareDims}>

  <!-- 顶部细返回条 -->
  <div class="max-w-7xl mx-auto px-5 pt-6">
    <a href={pathWithLang("/photo", lang)} class="text-xs uppercase tracking-[0.18em] text-white/55 hover:text-white transition-colors">
      ← {t("section.photo.title")}
    </a>
  </div>

  <!-- 全宽 cover hero -->
  {cover && (
    <section class="mt-6 mb-10">
      <div class="w-full bg-black overflow-hidden">
        {/* width/height 必须给：没有内在尺寸的图片加载完会把下方内容顶下去，
            实测相册页 CLS 0.232（Lighthouse 限值 0.1）。webp 版本让 LCP 字节数减半。 */}
        <picture>
          {cover.srcWebp && <source type="image/webp" srcset={cover.srcWebp} />}
          <img
            src={cover.src}
            alt={cover.alt}
            width={cover.width || undefined}
            height={cover.height || undefined}
            class="w-full h-auto max-h-[88vh] object-contain mx-auto block"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </section>
  )}

  <!-- 标题 + 元信息块（居中、克制） -->
  <header class="max-w-3xl mx-auto px-5 text-center pb-2">
    <h1 class="font-serif text-4xl sm:text-6xl leading-[1.05] tracking-tight text-white">
      {entry.data.title}
    </h1>
    {entry.data.description && (
      <p class="mt-4 text-base sm:text-lg text-white/65 leading-relaxed max-w-2xl mx-auto">
        {entry.data.description}
      </p>
    )}
    <div class="mt-6 inline-flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-[11px] uppercase tracking-[0.16em] text-white/55 font-mono">
      <time>{dateStr}</time>
      {entry.data.location && <><span class="opacity-50">/</span><span>{entry.data.location}</span></>}
      {entry.data.cameraSummary && <><span class="opacity-50">/</span><span>{entry.data.cameraSummary}</span></>}
      <span class="opacity-50">/</span>
      <span>{photos.length} frames</span>
    </div>
  </header>

  <!-- 可选随文文字（窄列） -->
  {(entry.body ?? "").trim().length > 0 && (
    <section class="max-w-prose mx-auto px-5 mt-10 mb-12 text-[15.5px] leading-[1.85] text-white/75">
      <Content />
    </section>
  )}

  <!-- 主图集（PhotoSwipe 瀑布流；用第二张起，避免与 hero 重复） -->
  {rest.length > 0 ? (
    <section class="max-w-7xl mx-auto px-2 sm:px-3 mt-12">
      <PhotoGallery photos={rest} galleryId={`gallery-${entry.data.translationKey}`} client:only="react" />
    </section>
  ) : null}

  {/* GPS 地图（有点的话） */}
  {geoPoints.length > 0 ? (
    <section class="max-w-5xl mx-auto px-5 mt-12">
      <PhotoMap points={geoPoints} client:visible />
    </section>
  ) : photos.length === 0 ? (
    <section class="max-w-2xl mx-auto px-5 mt-16 mb-24 text-center text-white/55">
      <p class="font-mono text-sm">还没上传照片。</p>
      <p class="mt-2 text-sm">
        到 <code class="text-white/80">/admin</code> → 「摄影相册」编辑这一条，
        把照片拖到媒体库里即可；部署后会自动出现在这里。
      </p>
    </section>
  ) : null}

  <!-- 底部 feedback + 返回 -->
  <section class="max-w-3xl mx-auto px-5 mt-20 pb-24 text-center">
    <div class="inline-block">
      <FeedbackButtons slug={`photo/${entry.data.translationKey}`} client:visible />
    </div>
    <div class="mt-10">
      <a href={pathWithLang("/photo", lang)} class="text-xs uppercase tracking-[0.18em] text-white/55 hover:text-white transition-colors">
        ← {t("section.photo.title")}
      </a>
    </div>
  </section>

</PhotoLayout>

<style is:global>
  /* 在 photo 详情页里，让 FeedbackButtons 的图标也跟随深底变色 */
  body:has(.photo-immersive) .photo-immersive [aria-label="喜欢"],
  body:has(.photo-immersive) .photo-immersive [aria-label="不喜欢"] {
    color: rgba(255,255,255,0.7);
  }
</style>
