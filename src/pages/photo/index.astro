---
import { getCollection } from "astro:content";
import PhotoLayout from "@/layouts/PhotoLayout.astro";
import { useTranslations, pathWithLang } from "@/i18n/ui";
import { sectionDescription } from "@/lib/descriptions";
import { loadPhotoManifest, resolveAlbumKey } from "@/lib/photo-manifests";
import { siteDateString } from "@/lib/site-date";

const lang = "zh" as const;
const t = useTranslations(lang);

const albums = (await getCollection("photo", (p) => p.data.lang === lang && !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const enriched = albums.map((album) => {
  const manifest = loadPhotoManifest(resolveAlbumKey(album.data));
  // 封面优先用 frontmatter.cover（后台可点选）；留空则退回第一张
  return { album, cover: album.data.cover || manifest[0]?.src || manifest[0]?.thumb, count: manifest.length };
});

// 编辑性网格：第 0、3、6… 张占 2 列，其余 1 列（更接近 VCG / Behance）
function colSpan(i: number) {
  return i % 3 === 0 ? "lg:col-span-2" : "lg:col-span-1";
}
function aspect(i: number) {
  return i % 3 === 0 ? "aspect-[16/9]" : "aspect-[4/5]";
}
---

<PhotoLayout
  title={t("section.photo.title")}
  description={sectionDescription(
    "photo",
    {
      count: enriched.length,
      photos: enriched.reduce((sum, a) => sum + a.count, 0),
      latest: albums[0] ? { title: albums[0].data.title, date: albums[0].data.date } : undefined,
    },
    lang,
  )}
>
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-5 pt-16 sm:pt-24 pb-12 text-center">
    <p class="text-[11px] uppercase tracking-[0.22em] text-white/55 font-mono">{enriched.length} albums</p>
    <h1 class="mt-4 font-serif text-5xl sm:text-7xl leading-[0.95] tracking-tight text-white">
      {t("section.photo.title")}
    </h1>
    <p class="mt-4 text-base sm:text-lg text-white/65 max-w-xl mx-auto leading-relaxed">
      {t("section.photo.desc")}
    </p>
    <p class="mt-5 text-sm leading-relaxed text-white/45 max-w-xl mx-auto">
      按主题分成一本本相册，封面来自相册的第一张；点进去可以逐张翻，也能看到拍摄地、时间与照片数量。
      原始照片的人工压缩只做一次，站内一律输出 1200×630 的分享图和 WebP 预览。
    </p>
    <p class="mt-2 text-sm leading-relaxed text-white/35 max-w-xl mx-auto">
      想追更新可以直接订阅 <a href="/rss.xml" class="underline decoration-1 underline-offset-2 hover:text-white/60">RSS</a>，
      相册封面也会出现在
      <a href="/tag/photo/" class="underline decoration-1 underline-offset-2 hover:text-white/60">#photo 标签</a> 下。
    </p>
  </section>

  <!-- 网格 -->
  <section class="max-w-7xl mx-auto px-2 sm:px-3 pb-24">
    {enriched.length === 0 ? (
      <div class="py-24 text-center text-white/55">
        <p class="font-serif text-2xl mb-3">还没有相册</p>
        <p class="text-sm leading-relaxed max-w-md mx-auto">
          打开 <a href="/admin" class="underline hover:text-white">/admin</a>
          → 「摄影相册」 → 新建，填好标题和相册编号，再用页面里的媒体按钮把照片拖进来。
          保存后部署会自动抽 EXIF 生成相册。
        </p>
      </div>
    ) : (
      <h2 class="sr-only">全部相册</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-3">
        {enriched.map(({ album, cover, count }, i) => (
          <li class={colSpan(i)}>
            <a href={pathWithLang(`/photo/${album.data.translationKey}`, lang)} class="group relative block overflow-hidden bg-neutral-900">
              <div class={`${aspect(i)} overflow-hidden`}>
                {cover ? (
                  <img src={cover} alt={album.data.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-[800ms] ease-out group-hover:scale-[1.04]" />
                ) : (
                  <div class="w-full h-full grid place-items-center text-white/30 text-4xl font-serif">·</div>
                )}
              </div>
              <!-- 标题永远显示在底部，hover 时变白+底部渐变更浓 -->
              <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5 transition-all duration-300" style="background: linear-gradient(to top, rgba(0,0,0,0.78), rgba(0,0,0,0))">
                <h3 class="font-serif text-xl sm:text-2xl leading-tight text-white">{album.data.title}</h3>
                <div class="mt-1 flex items-center gap-2 text-[10.5px] uppercase tracking-[0.14em] font-mono text-white/65">
                  <time>{siteDateString(album.data.date)}</time>
                  <span class="opacity-50">/</span>
                  <span>{count} frames</span>
                  {album.data.location && <><span class="opacity-50">/</span><span class="normal-case tracking-normal">{album.data.location}</span></>}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</PhotoLayout>
